@inherits ElementComponentBase
@{
    var tabType = string.Empty;
    switch (Type)
    {
        case TabType.Normal:
            tabType = string.Empty;
            break;
        case TabType.BorderCard:
            tabType = "el-tabs--border-card";
            break;
        case TabType.Card:
            tabType = "el-tabs--card";
            break;
    }
    var position = GetPosition();
    var headerPosition = position.headerPosition;
    var tabPosition = position.tabPosition;
    var classBuilder = HtmlPropertyBuilder.CreateCssClassBuilder()
        .Add("el-tabs", tabType, tabPosition, Cls)
        .AddIf(Stretch, "is-stretch");
    object activeContent = ActiveTab?.ChildContent;
    var bodyStyle = ActiveTab?.Style;
    if (DataSource != null)
    {
        var activeOption = DataSource.FirstOrDefault(x => x.IsActive);
        activeContent = activeOption?.Content;
        bodyStyle = activeOption?.BodyStyle;
    }
}
<div class="@classBuilder.ToString()" style="@Style" @attributes="Attributes">
    @if (TabPosition == TabPosition.Bottom)
    {
        <div class="el-tabs__content" style="@bodyStyle" @ref="Content" role="tabpanel" aria-labelledby="tab-@(ActiveTab?.Name)" id="pane-@(ActiveTab?.Name)">
            <ElDynamicComponent Component="activeContent"></ElDynamicComponent>
        </div>
    }
    <div class="el-tabs__header @headerPosition">
        @if (IsAddable || IsEditable)
        {
            <span tabindex="0" class="el-tabs__new-tab" @onclick="OnInternalAddingTabAsync"><i class="el-icon-plus"></i></span>
        }
        <div class="el-tabs__nav-wrap @headerPosition">
            <div class="el-tabs__nav-scroll" @ref="navScrollElement">
                @* 批次81：键盘导航（←/→/Home/End）原来挂在组件根 div 上，事件委托会吃到页签内容里输入框冒泡上来的
                   方向键/Home/End——款号编辑等对话框里在输入框中按 ←/→ 移光标会把整个页签切走（Home/End 直接跳首/尾页签）。
                   EP 的语义是焦点落在页签条上才导航，所以 @onkeydown 挪到下面这个 role=tablist 上：
                   键事件只在焦点位于页签头（页签项有 roving tabindex）时冒泡到这里，pane 内容里的按键不再触发。 *@
                <div role="tablist" class="el-tabs__nav @headerPosition" style="transform: translateX(0px);@NavAlignStyle" aria-orientation="@(TabPosition == TabPosition.Left || TabPosition == TabPosition.Right ? "vertical" : "horizontal")" @onkeydown="OnKeyDownAsync">
                    @if (Type == TabType.Normal)
                    {
                    <div class="el-tabs__active-bar @headerPosition" style="width: @(BarWidth)px; transform: translateX(@(BarOffsetLeft)px);"></div>
                    }
                    <CascadingValue Value=this>
                        @if (DataSource != null)
                        {
                            @foreach (var item in DataSource)
                            {
                                <ElTabPane @key="item.Name" IsClosable="@(item.IsClosable || IsRemovable || IsEditable)" Disabled="@item.IsDisabled" Name="@item.Name" Title="@item.Title" IsActive="@item.IsActive" OnRenderCompleted="item.OnRenderCompletedAsync" OnTabPanelChanging="item.OnTabPanelChanging">
                                    <ElDynamicComponent Component="@item.Content"></ElDynamicComponent>
                                </ElTabPane>
                            }
                        }
                        else
                        {
                            @ChildContent
                        }
                    </CascadingValue>
                </div>
            </div>
        </div>
    </div>
    @if (TabPosition != TabPosition.Bottom)
    {
        <div class="el-tabs__content" style="@bodyStyle" @ref="Content" role="tabpanel" aria-labelledby="tab-@(ActiveTab?.Name)" id="pane-@(ActiveTab?.Name)">
            <ElDynamicComponent Component="activeContent"></ElDynamicComponent>
        </div>
    }
</div>
