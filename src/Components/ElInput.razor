    @inherits ElementFieldComponentBase<TValue>
@typeparam TValue
@{
    var text = DisplayText;
    var nativeValue = text ?? string.Empty;
    var isClearable = Value != null && Clearable && !IsInputDisabled && !Readonly && (ShowClearIcon || IsFocus || IsMouseOver);
    var hasSuffix = HasSuffix;
    var clearIconCls = string.IsNullOrWhiteSpace(ClearIcon) ? "el-icon-circle-close" : ClearIcon;
    // 后缀侧预留宽度 = max(插槽后缀实测宽, 密码切换 60px, 字数统计 60px)；
    // 插槽前缀宽度由 JS 测量后回写（affixPrefixPadding），插槽内容变宽也不会压住输入文字。
    var suffixReserved = affixSuffixPadding;
    if (ShowPasswordToggle)
    {
        suffixReserved = Math.Max(suffixReserved, 60);
    }
    if (IsWordLimitVisible && !HasWordLimitOutside)
    {
        suffixReserved = Math.Max(suffixReserved, 60);
    }
    // 掩码走内联样式而非 el-input__masked 类：掩码场出生即要有 text-security（分类在入树时刻定型），
    // 且 affix interop 重写 style 属性时这里会一并重写，内联值不会被抹掉。
    var inputStyle = HtmlPropertyBuilder.CreateCssStyleBuilder()
        .Add(InputStyle)
        .AddIf(UseMaskedPassword && !passwordVisible, "-webkit-text-security:disc")
        .AddIf(affixPrefixPadding > 0, $"padding-left:{affixPrefixPadding}px")
        .AddIf(suffixReserved > 0, $"padding-right:{suffixReserved}px")
        .AddIf(!string.IsNullOrWhiteSpace(Image), "background: transparent", "border: transparent")
        .ToString();
    var textareaStyle = HtmlPropertyBuilder.CreateCssStyleBuilder()
        .Add(InputStyle)
        .AddIf(IsWordLimitVisible && !HasWordLimitOutside, "padding-right:52px")
        .AddIf(!string.IsNullOrWhiteSpace(Image), "background: transparent", "border: transparent")
        .AddIf(!string.IsNullOrWhiteSpace(Resize), $"resize:{Resize}")
        .AddIf(Autosize && autosizeHeight > 0, $"height:{autosizeHeight}px;overflow-y:hidden")
        .ToString();
    var _filteredAttrs = Attributes?.Where(kv => kv.Key != null && kv.Key[0] != '@')?.ToDictionary(kv => kv.Key, kv => kv.Value);
}
<div class="@wrapperClsBuilder" @ref="Content" style="@HtmlPropertyBuilder.CreateCssStyleBuilder().Add(Style).AddIf(!string.IsNullOrWhiteSpace(Image),$"background:url('{Image}') center center no-repeat")" @onclick="OnClick" @onmouseover="OnWrapperMouseEnterAsync" @onmouseout="OnWrapperMouseLeaveAsync">
    @if (Prepend != null && Type != InputType.Textarea)
    {
        <div class="el-input-group__prepend">
            @Prepend
        </div>
    }
    @if (Type == InputType.Textarea)
    {
        <textarea id="@Id" style="@textareaStyle" @ref="InputElement" @attributes="_filteredAttrs" @onclick="OnInputClick" placeholder="@Placeholder" value="@nativeValue" class="@InputElementClass" @onfocus="OnFocusEventAsync" @onblur="OnBlurEventAsync" @oninput="OnChangeEventArgs" @onchange="OnNativeChangeAsync" name="@Name" disabled="@IsInputDisabled" readonly="@Readonly" maxlength="@NativeMaxlength" minlength="@NativeMinlength" rows="@Rows" autocomplete="@NativeAutocomplete" autofocus="@Autofocus" tabindex="@Tabindex" aria-label="@EffectiveAriaLabel" inputmode="@Inputmode" form="@Form" aria-invalid="@IsAriaInvalid" aria-describedby="@AriaDescribedBy" />
        @if (isClearable)
        {
            <i class="el-textarea__icon el-textarea__clear @clearIconCls @(AdditionalClearIcon ?? string.Empty)" @onclick="ClearOnClick"></i>
        }
        @if (IsWordLimitVisible)
        {
            <span class="el-input__count @(HasWordLimitOutside ? "is-outside" : string.Empty)">@CharactersText</span>
        }
    }
    else
    {
        @if (HasPrefix)
        {
            <span class="el-input__prefix">
                <span class="el-input__prefix-inner">
                    @if (Prefix != null)
                    {
                        @Prefix
                    }
                    @if (!string.IsNullOrWhiteSpace(PrefixIcon))
                    {
                        <i class="el-input__icon @PrefixIcon" @onclick="OnPrefixIconClick"></i>
                    }
                </span>
            </span>
        }
        <input id="@Id" type="@NativeInputType" style="@inputStyle" @ref="InputElement" @attributes="_filteredAttrs" @onclick="OnInputClick" placeholder="@Placeholder" value="@nativeValue" class="@InputElementClass" @onfocus="OnFocusEventAsync" @onblur="OnBlurEventAsync" @oninput="OnChangeEventArgs" @onchange="OnNativeChangeAsync" @onkeydown="OnKeyDown" name="@Name" disabled="@IsInputDisabled" readonly="@Readonly" maxlength="@NativeMaxlength" minlength="@NativeMinlength" max="@Max" min="@Min" step="@Step" autocomplete="@NativeAutocomplete" autofocus="@Autofocus" tabindex="@Tabindex" aria-label="@EffectiveAriaLabel" inputmode="@Inputmode" form="@Form" aria-invalid="@IsAriaInvalid" aria-describedby="@AriaDescribedBy" data-lpignore="@NativeLpIgnore" data-1p-ignore="@NativeLpIgnore" />
        @if (hasSuffix)
        {
            <span class="el-input__suffix">
                <span class="el-input__suffix-inner">
                    @if (isClearable)
                    {
                        <i class="el-input__icon el-input__clear @clearIconCls @(AdditionalClearIcon ?? string.Empty)" @onclick="ClearOnClick"></i>
                    }
                    else if (!string.IsNullOrWhiteSpace(SuffixIcon))
                    {
                        <i class="el-input__icon @SuffixIcon" @onclick="OnSuffixIconClick"></i>
                    }
                    @if (Suffix != null)
                    {
                        @Suffix
                    }
                    @if (ShowPasswordToggle)
                    {
                        <i class="el-input__icon el-input__password" @onclick="TogglePasswordVisibilityAsync" aria-label="@(PasswordVisible ? "隐藏密码" : "显示密码")" title="@(PasswordVisible ? "隐藏密码" : "显示密码")">
                            @if (PasswordIcon != null)
                            {
                                @PasswordIcon(PasswordVisible)
                            }
                            else if (PasswordVisible)
                            {
                                <svg class="el-input__password-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M1.8 12S5.4 5.9 12 5.9 22.2 12 22.2 12 18.6 18.1 12 18.1 1.8 12 1.8 12z"></path>
                                    <circle cx="12" cy="12" r="3.1"></circle>
                                </svg>
                            }
                            else
                            {
                                <svg class="el-input__password-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M3.2 3.2 20.8 20.8"></path>
                                    <path d="M10.4 6A10.6 10.6 0 0 1 12 5.9c6.6 0 10.2 6.1 10.2 6.1a18.6 18.6 0 0 1-3.2 4"></path>
                                    <path d="M6.3 7.9A18.4 18.4 0 0 0 1.8 12S5.4 18.1 12 18.1a10.4 10.4 0 0 0 4.3-.9"></path>
                                    <path d="M9.7 9.8a3.2 3.2 0 0 0 4.5 4.5"></path>
                                </svg>
                            }
                        </i>
                    }
                    @if (IsWordLimitVisible && !HasWordLimitOutside)
                    {
                        <span class="el-input__count">
                            <span class="el-input__count-inner">@CharactersText</span>
                        </span>
                    }
                    @if (HasValidationStatusIcon)
                    {
                        <i class="@ValidationStatusIconClass"></i>
                    }
                </span>
            </span>
        }
        @if (HasWordLimitOutside)
        {
            <span class="el-input__count is-outside">
                <span class="el-input__count-inner">@CharactersText</span>
            </span>
        }
        @if (Append != null)
        {
            <div class="el-input-group__append">
                @Append
            </div>
        }
    }
</div>
