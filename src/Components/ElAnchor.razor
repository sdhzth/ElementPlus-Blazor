@inherits ElementComponentBase

<div id="@Id" aria-label="@AriaLabel" class="@AnchorClass" style="@Style" @ref="RootElement" @attributes="Attributes">
    @if (Marker)
    {
        @if (CursorTemplate != null)
        {
            @CursorTemplate
        }
        else
        {
            <span class="el-anchor__marker"></span>
        }
    }
    <div class="el-anchor__list">
        <CascadingValue Value="this" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </div>
</div>
