@inherits ElementComponentBase

<div class="blazor-ribbon">
    <div class="blazor-tabs" style="@styleBuilder.ToString()">
        <ElTabs OnActiveTabChanging="PreventMenuSwitchAsync" Type="@TabType.BorderCard" @bind-Value="ModelValue">
            <ElTabPane Name="__ribbon_menu__" Title="@(MenuText ?? "开始")" @ref="menuTabPanel" Style="@menuStyleBuilder.ToString()">

            </ElTabPane>
            @Tabs
        </ElTabs>
    </div>
    <div class="blazor-body">
        @Body
    </div>
</div>