<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ElementPlus.X</RootNamespace>
    <AssemblyName>ElementPlus.X</AssemblyName>
    <ApplicationIcon />
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>Element-Plus.X</PackageId>
    <Title>Element-Plus X</Title>
    <Version>0.11.0</Version>
    <Authors>Smart</Authors>
    <Company>Element-Plus</Company>
    <Description>AI and conversation scene components for Element-Plus, inspired by Element Plus X. Independent package line published by Smart.</Description>
    <PackageProjectUrl>https://github.com/Element-Plus-Blazor/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Element-Plus-Blazor/Element-Plus-Blazor/</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RazorLangVersion>3.0</RazorLangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Product>Element-Plus.X</Product>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>PACKAGE_README.X.md</PackageReadmeFile>
    <PackageIcon>LOGO.png</PackageIcon>
    <PackageTags>blazor;components;razor;ui;element;element-plus;x;ai;chat;conversation;net10</PackageTags>
    <PackageReleaseNotes>Element-Plus.X 0.10 line follows the Element-Plus version line and .NET 10 baseline. Independent package line published by Smart.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <NoWarn>$(NoWarn);1591;1701;1702;CS0108;CS1573;BL0005;BL0007</NoWarn>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DocumentationFile>obj\Debug\net10.0\Element.X.xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DocumentationFile>obj\Release\net10.0\Element.X.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LOGO.png">
      <Pack>true</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\..\LICENSE">
      <Pack>true</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\..\PACKAGE_README.X.md">
      <Pack>true</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="wwwroot\css\x.css" />
    <None Include="wwwroot\js\x.js" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.300" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Components\Element.csproj" />
  </ItemGroup>

</Project>
