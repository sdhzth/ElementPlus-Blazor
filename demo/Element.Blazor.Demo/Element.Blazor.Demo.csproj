<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ElementPlus.Blazor.Demo</RootNamespace>
    <AssemblyName>ElementPlus.Blazor.Demo</AssemblyName>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <NoWarn>$(NoWarn);1591;BL0005;BL0007;CS1591;CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8610;CS8616;CS8618;CS8619;CS8620;CS8621;CS8622;CS8624;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Components\Element.csproj" />
    <ProjectReference Include="..\..\src\Markdown\Element.Markdown.csproj" />
    <ProjectReference Include="..\..\src\X\Element.X.csproj" />
  </ItemGroup>

  <!--
    demo 页源码随程序集一起下发：供每个示例块右下角的「复制代码 / 查看源代码」读取。
    Blazor WASM 跑在浏览器里读不到磁盘上的 .razor，所以在编译期以 EmbeddedResource
    打进程序集（资源名 DemoSource.<文件名>.razor，读取见 Shared/DemoSourceStore.cs）。
  -->
  <ItemGroup>
    <EmbeddedResource Include="Pages\**\*.razor" LogicalName="DemoSource.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Components\**\*.razor" LogicalName="DemoSource.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
