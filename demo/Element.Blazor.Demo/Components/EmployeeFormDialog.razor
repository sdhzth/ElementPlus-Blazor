@using ElementPlus
@inject ElementPlus.MessageBox MessageBox
@*
    服务化对话框的「内容组件」示例：一个完整的 ElForm 表单 + 确定/取消按钮。
    通过级联 ElDialogGrowRef 调 CloseAsync(model) 把表单数据回传给调用方。
*@

<div class="demo-dialog-form">
    <ElForm @ref="form" Model="@Model" LabelWidth="@("90px")" Validations="validations">
        <ElFormItem TValue="string" Name="Name" Label="姓名" Prop="Name">
            <ElInput TValue="string" @bind-Value="Model.Name" Placeholder="请输入姓名" />
        </ElFormItem>
        <ElFormItem TValue="int" Name="Age" Label="年龄" Prop="Age">
            <ElInput TValue="int" @bind-Value="Model.Age" Placeholder="0 ~ 120" />
        </ElFormItem>
        <ElFormItem TValue="string" Name="Department" Label="部门" Prop="Department">
            <ElSelect TValue="string" @bind-Value="Model.Department" Placeholder="请选择部门" Clearable>
                @foreach (var d in Departments)
                {
                    <ElOption TValue="string" Value="@d" Text="@d" />
                }
            </ElSelect>
        </ElFormItem>
        <ElFormItem TValue="bool" Name="OnDuty" Label="在职" Prop="OnDuty">
            <ElSwitch TValue="bool" @bind-Value="Model.OnDuty" />
        </ElFormItem>
    </ElForm>

    @if (ShowHint)
    {
        <p class="demo-note">本次打开传入的参数：<code>@Hint</code>；初始姓名：<code>@initialName</code>。</p>
    }

    <div class="demo-dialog-form__footer">
        <ElButton OnClick="RenameTitleAsync">改对话框标题</ElButton>
        <ElButton OnClick="Cancel">取消</ElButton>
        <ElButton Type="ButtonType.Primary" OnClick="SubmitAsync">确定</ElButton>
    </div>
</div>

@code {
    /// <summary>待编辑的数据（打开时由调用方传入；组件直接改它，点确定后整体回传）。</summary>
    [Parameter]
    public EmployeeModel Model { get; set; } = new();

    /// <summary>对话框标题栏下方展示的提示文案（演示「参数传入对话框组件」）。</summary>
    [Parameter]
    public string Hint { get; set; }

    /// <summary>是否显示参数提示。</summary>
    [Parameter]
    public bool ShowHint { get; set; } = true;

    /// <summary>对话框级联引用，由 ElDialogGrow 下发。</summary>
    [CascadingParameter]
    public ElDialogGrowRef Dialog { get; set; }

    private ElForm form;
    private string initialName;

    private static readonly string[] Departments =
    {
        "门诊部", "住院部", "检验科", "影像科", "药剂科"
    };

    /// <summary>真实校验规则：姓名必填、年龄 0~120、部门必选。</summary>
    private readonly List<FormFieldValidation> validations = new List<FormFieldValidation>
    {
        new FormFieldValidation
        {
            Name = "Name",
            Rules = new List<IValidationRule>
            {
                new RequiredRule { ErrorMessage = "请填写姓名" }
            }
        },
        new FormFieldValidation
        {
            Name = "Department",
            Rules = new List<IValidationRule>
            {
                new RequiredRule { ErrorMessage = "请选择部门" }
            }
        }
    };

    protected override void OnInitialized()
    {
        initialName = Model?.Name ?? "（空）";
    }

    private async Task SubmitAsync()
    {
        // 校验不通过时提示错误、不关闭对话框 —— 这是「表单放对话框」最常见的诉求。
        if (form != null && !await form.ValidateAsync())
        {
            return;
        }

        if (Model.Age is < 0 or > 120)
        {
            await MessageBox.AlertAsync("年龄必须在 0 ~ 120 之间。");
            return;
        }

        // 校验通过 → 回传模型实例，调用方 await OpenAsync 拿到它。
        await Dialog.CloseAsync(Model);
    }

    private Task Cancel()
    {
        return Dialog.CloseAsync(null);
    }

    private int renameCount;

    /// <summary>
    /// 演示「对话框已打开，内容组件运行时改自己的标题」（对齐 Radzen 的 Dialog.Title 赋值）。
    /// 走级联 <see cref="ElDialogGrowRef.Title"/>：赋值后服务化路径会落到
    /// <c>ElDialogGrowOptions.Title</c> 并通知宿主重渲染，标题栏立即更新。
    /// </summary>
    private Task RenameTitleAsync()
    {
        Dialog.Title = $"编辑员工信息（第 {++renameCount} 次改标题）";
        return Task.CompletedTask;
    }
}