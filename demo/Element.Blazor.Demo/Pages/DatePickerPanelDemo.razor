@page "/datepickerpanel"
@using ElementPlus

<h1 class="demo-page-title">日期面板 / ElDatePickerPanel</h1>
<p class="demo-page-sub">对齐官方：内嵌式日期面板，支持 @("@bind-Value")、Type、DisabledDate、ShowWeekNumber、Shortcuts 与 Footer 插槽，可作为自定义筛选器的一部分。</p>

<div class="demo-section">
    <h3>基础面板</h3>
    <div class="demo-row" style="align-items:flex-start">
        <ElDatePickerPanel @bind-Value="date1" />
        <ElDatePickerPanel @bind-Value="date2" ShowWeekNumber="true" />
    </div>
    <p class="demo-note">date1=@(date1?.ToString("yyyy-MM-dd"))　date2=@(date2?.ToString("yyyy-MM-dd"))</p>
</div>

<div class="demo-section">
    <h3>带快捷选项与底部</h3>
    <div class="demo-row" style="align-items:flex-start">
        <ElDatePickerPanel @bind-Value="date1" Shortcuts="shortcuts">
            <FooterContent>
                <div style="padding:4px 8px;font-size:12px;color:#909399">自定义底部</div>
            </FooterContent>
        </ElDatePickerPanel>
    </div>
</div>

@code {
    private DateTime? date1 = DateTime.Today;
    private DateTime? date2;

    private List<DatePickerShortcut> shortcuts = new List<DatePickerShortcut>
    {
        new DatePickerShortcut { Text = "今天", ValueFactory = () => DateTime.Today },
        new DatePickerShortcut { Text = "一周前", ValueFactory = () => DateTime.Today.AddDays(-7) }
    };
}
