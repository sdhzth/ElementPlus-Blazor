@page "/datepicker"
@using ElementPlus

<h1 class="demo-page-title">日期选择器 / ElDatePicker</h1>
<p class="demo-page-sub">对齐官方：支持 @("@bind-Value")（DateTime?）、Type（Date/Month/Year/Range）、Format、Clearable、DisabledDate，以及扩展的 Shortcuts 快捷选项。</p>

<div class="demo-section">
    <h3>基础用法</h3>
    <div class="demo-row">
        <ElDatePicker @bind-Value="date1" Placeholder="选择日期" />
        <ElDatePicker @bind-Value="date2" Type="DatePickerType.Month" Placeholder="选择月份" />
        <ElDatePicker @bind-Value="date3" Type="DatePickerType.Year" Placeholder="选择年份" />
    </div>
    <p class="demo-note">date1=@(date1?.ToString("yyyy-MM-dd"))　date2=@(date2?.ToString("yyyy-MM"))　date3=@(date3?.ToString("yyyy"))</p>
</div>

<div class="demo-section">
    <h3>日期范围</h3>
    <div class="demo-row">
        <ElDatePicker @bind-RangeValue="range1" Type="DatePickerType.DateRange" RangeSeparator="至" />
    </div>
</div>

<div class="demo-section">
    <h3>快捷选项 + 禁用部分日期</h3>
    <div class="demo-row">
        <ElDatePicker @bind-Value="date1" Shortcuts="shortcuts" Placeholder="带快捷选项" />
    </div>
    <p class="demo-note">带快捷列时弹层要让出侧栏那一列：宽度按 EP 2.14.0 的 <code>.el-date-picker.has-sidebar</code> = 438px（批次㉕ #124 之前写死 322，日历右侧列被裁、面板底部冒横向滚动条）。</p>
</div>

<div class="demo-section">
    <h3>范围 + 快捷选项</h3>
    <div class="demo-row">
        <ElDatePicker @bind-RangeValue="rangeShortcut" Type="DatePickerType.DateRange" Shortcuts="rangeShortcuts" RangeSeparator="至" Placeholder="带快捷选项的范围" />
    </div>
    <p class="demo-note">双面板同样带左侧快捷列，宽度按 EP 的 <code>.el-date-range-picker.has-sidebar</code> = 756px（646 + 110）。</p>
</div>

<div class="demo-section">
    <h3>显示周数 (ShowWeekNumber)</h3>
    <div class="demo-row">
        <ElDatePicker @bind-Value="dateWeek" ShowWeekNumber="true" Placeholder="带周数" />
    </div>
    <p class="demo-note">面板左侧首列展示 ISO 周数（对齐 EP show-week-number）。</p>
</div>

<div class="demo-section">
    <h3>底部区 / 确定按钮 (Footer / ShowConfirm)</h3>
    <div class="demo-row">
        <ElDatePicker @bind-Value="dateConfirm" Type="DatePickerType.DateRange" ShowConfirm="true" Placeholder="带确定按钮" />
        <ElDatePicker @bind-Value="dateFooter" Footer="footerContent" Placeholder="带自定义页脚" />
    </div>
    <p class="demo-note">ShowConfirm 在面板底部渲染「确定」按钮；Footer 插槽优先级更高，可放任意自定义内容。</p>
</div>

<div class="demo-section">
    <h3>清除回写值 (ValueOnClear)</h3>
    <div class="demo-row">
        <ElDatePicker @bind-Value="dateClear" ValueOnClear="new DateTime(2000,1,1)" Clearable="true" Placeholder="清除后回写 2000-01-01" />
    </div>
    <p class="demo-note">点击清除按钮回写 ValueOnClear 指定的值（默认 null），对齐 EP value-on-clear。</p>
</div>

<div class="demo-section">
    <h3>面板取消联动 (UnlinkPanels)</h3>
    <div class="demo-row">
        <ElDatePicker @bind-RangeValue="rangeUnlink" Type="DatePickerType.DateRange" UnlinkPanels="true" Placeholder="左右面板独立翻页" />
    </div>
    <p class="demo-note">开启 UnlinkPanels 后，范围选择左右两个日期面板各自独立翻页、互不跟随（对齐 EP unlink-panels，2.5.0+）。默认联动时翻动一侧另一侧自动保持相邻一个月。</p>
</div>

@code {
    private DateTime? date1 = DateTime.Today;
    private DateTime? date2;
    private DateTime? date3;
    private DateTime? dateWeek = DateTime.Today;
    private DateTime? dateConfirm;
    private DateTime? dateFooter;
    private DateTime? dateClear = DateTime.Today;
    private IList<DateTime?> range1 = new List<DateTime?>();
    private IList<DateTime?> rangeUnlink = new List<DateTime?>();
    private IList<DateTime?> rangeShortcut = new List<DateTime?>();

    private RenderFragment footerContent = builder => builder.AddContent(0, "自定义页脚内容");

    private List<DatePickerShortcut> shortcuts = new List<DatePickerShortcut>
    {
        new DatePickerShortcut { Text = "今天", ValueFactory = () => DateTime.Today },
        new DatePickerShortcut { Text = "昨天", ValueFactory = () => DateTime.Today.AddDays(-1) },
        new DatePickerShortcut { Text = "一周前", ValueFactory = () => DateTime.Today.AddDays(-7) }
    };

    private static List<DatePickerShortcut> rangeShortcuts = new List<DatePickerShortcut>
    {
        new DatePickerShortcut { Text = "最近 7 天", RangeValueFactory = () => new DateTime?[] { DateTime.Today.AddDays(-6), DateTime.Today } },
        new DatePickerShortcut { Text = "本月", RangeValueFactory = () => new DateTime?[] { MonthStart, MonthEnd } },
        new DatePickerShortcut { Text = "本季度", RangeValueFactory = () => new DateTime?[] { QuarterStart, QuarterEnd } }
    };

    // 用表达式体属性而不是多语句 lambda：Razor 的 @code 解析器在 `() => { …; return …; }` 里会数错花括号、提前认掉代码块（实测报 CS0116）。
    private static DateTime MonthStart => new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

    private static DateTime MonthEnd => MonthStart.AddMonths(1).AddDays(-1);

    private static DateTime QuarterStart => new DateTime(DateTime.Today.Year, (DateTime.Today.Month - 1) / 3 * 3 + 1, 1);

    private static DateTime QuarterEnd => QuarterStart.AddMonths(3).AddDays(-1);
}
