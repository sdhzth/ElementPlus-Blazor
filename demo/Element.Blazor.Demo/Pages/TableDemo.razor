    {
        detailText = $"已选：#{p.Id} {p.Name}（{p.Category}）单价 ¥{p.Price:N2}，库存 {p.Stock}，{p.CreatedAt:yyyy-MM-dd}";
        StateHasChanged();
    }

    // ===== ⑪ 列头点击弹出菜单：状态与回调都在 HeaderMenuDemo 组件里（见 Components/HeaderMenuDemo.razor） =====

    private static string BarColor(int stock)
    {
        // 库存阈值配色：缺货红 / 偏低橙 / 充足绿
        return stock < 100 ? "#f56c6c" : stock < 500 ? "#e6a23c" : "#67c23a";
    }

    private static int BarWidth(int stock)
    {
        // 1500 记作满格
        return Math.Min(100, stock * 100 / 1500);
    }

    // ===== ④ 树形表格 =====

    /// <summary>树形表格的节点模型：必须继承 ElementPlus.TreeItemBase，并自带头/父级 Id 与层级字段。</summary>
    private class OrgNode : ElementPlus.TreeItemBase
    {
        public string Name { get; set; }
        public string Kind { get; set; }
        public string Director { get; set; }
        public int Capacity { get; set; }
        public string Status { get; set; }
    }

    /// <summary>构建一份「院区 → 学科系统 → 科室 → 病区/医疗组」扁平层级数据（靠 ParentId 串成树）。</summary>
    private static List<OrgNode> BuildOrgTree()
    {
        var list = new List<OrgNode>();
        var id = 0;
        OrgNode Add(string name, string kind, string director, int capacity, string status, int parentId, bool hasChildren = false)
        {
            var node = new OrgNode
            {
                Id = ++id,
                ParentId = parentId,
                Name = name,
                Kind = kind,
                Director = director,
                Capacity = capacity,
                Status = status,
                HasChildren = hasChildren
            };
            list.Add(node);
            return node;
        }

        var hosp = Add("总院（本院区）", "院区", "王院长", 1200, "正常", 0, true);

        var internalSys = Add("内科系统", "学科系统", "李内主任", 0, "正常", hosp.Id, true);
        var cardio = Add("心血管内科", "科室", "张文博", 60, "满员", internalSys.Id, true);
        Add("心血管一病区", "病区", "赵护士长", 30, "正常", cardio.Id);
        Add("心血管二病区", "病区", "钱护士长", 30, "正常", cardio.Id);
        var resp = Add("呼吸内科", "科室", "孙呼吸", 50, "正常", internalSys.Id, true);
        Add("呼吸重症监护室 RICU", "病区", "周监护", 12, "满员", resp.Id);

        var surgSys = Add("外科系统", "学科系统", "吴外主任", 0, "正常", hosp.Id, true);
        var general = Add("普外科", "科室", "郑普外", 55, "正常", surgSys.Id, true);
        Add("胃肠外科组", "医疗组", "王胃肠", 20, "正常", general.Id);
        Add("肝胆外科组", "医疗组", "冯肝胆", 18, "正常", general.Id);
        var ortho = Add("骨科", "科室", "陈骨科", 48, "正常", surgSys.Id, true);
        Add("创伤骨科组", "医疗组", "褚创伤", 22, "正常", ortho.Id);

        var tech = Add("医技科室", "学科系统", "卫医技", 0, "正常", hosp.Id, true);
