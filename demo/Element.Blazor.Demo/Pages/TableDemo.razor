    private string lastAction = "（尚未保存过）";
    private string headerClickMsg = "（尚未点击任何表头）";
    private string detailText = "点击某行的「详情」按钮，这里会显示该行数据。";

    private Task OnProductSave(TableSaveEventArgs e)
    {
        var row = (Product)e.Data;
        switch (e.Action)
        {
            case SaveAction.Create:
                row.Id = products.Count == 0 ? 1 : products.Max(x => x.Id) + 1;
                products.Add(row);
                lastAction = $"新增 #{row.Id}：{row.Name} / {row.Category} / ¥{row.Price} / 库存 {row.Stock} / {(row.OnSale ? "在售" : "下架")}";
                break;

            case SaveAction.Update:
                var index = products.FindIndex(x => x.Id == row.Id);
                if (index >= 0)
                {
                    products[index] = row;
                }
                lastAction = $"更新 #{row.Id}：{row.Name} / {row.Category} / ¥{row.Price} / 库存 {row.Stock} / {(row.OnSale ? "在售" : "下架")}";
                break;

            case SaveAction.Delete:
                var hit = products.FirstOrDefault(x => x.Id == row.Id);
                if (hit != null)
                {
                    products.Remove(hit);
                    lastAction = $"删除 #{row.Id}：{hit.Name}";
                }
                break;
        }

        editTable?.Refresh();
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>①「名称」列表头点击事件：演示 ElTableColumn.OnHeaderClick（仅该列设置了此属性）。</summary>
