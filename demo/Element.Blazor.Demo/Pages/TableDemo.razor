@code {
    // ===== 单元格格式化函数（Formatter）—— EP 2.14.0 table/src/config.ts:193-208 的四档口径 =====
    // 第三个参数必须是属性原值（decimal / int），不是默认渲染器的文本；显示成「非原值:…」就说明接线又坏了。
    private static readonly Func<object, object, object, int, object> FormatPrice =
        (row, header, value, index) => value is decimal d ? "¥" + d.ToString("N2") : "非原值:" + Convert.ToString(value);

    private static readonly Func<object, object, object, int, object> FormatStock =
        (row, header, value, index) => value is int n ? (n > 200 ? "充足" : n > 50 ? "偏少" : "紧张") : "非原值";

    private static readonly Func<object, object, object, int, object> FormatIndex =
        (row, header, value, index) => "第 " + (index + 1) + " 行";

    private static readonly Func<object, object, object, int, object> FormatMustNotRun =
        (row, header, value, index) => "不该出现";

    private static readonly Func<object, object, object, int, object> FormatBold =
        (row, header, value, index) => "<b class=\"fmt-bold\">" + Convert.ToString(value) + "</b>";

    private ElTable editTable;

    // 供应商单元格存的是编码（"S01"…），显示态映射成名称；编码找不到时退回显示原值。
    // 该列同时带具名片段 <EditorColumns>，所以显示模板必须写成显式 <ChildContent>，隐式子内容会报 RZ9996。
    private static string SupplierDisplayText(object row)
        => row is Product p ? (MockData.Suppliers.FirstOrDefault(s => s.Code == p.Supplier)?.Name ?? p.Supplier) : Convert.ToString(row);

    // ⑬ 截断悬停演示：名称给到 160px 列放不下，类别放得下 —— 同表内形成「弹 / 不弹」对照
