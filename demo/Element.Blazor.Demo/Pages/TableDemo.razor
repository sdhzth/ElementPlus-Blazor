    };

    /// <summary>⑫ 表头单元格样式回调（HeaderCellStyle）：仅给「名称」列表头单独上色，其余返回 null。</summary>
    private Dictionary<string, string> WireHeaderCellStyle(object row, TableHeader header, int rowIndex, int columnIndex)
    {
        // 按属性名认列：表头文字是给人看的，演示与探针都可能改它。
        if (header?.Property?.Name == "Name")
        {
            return new Dictionary<string, string> { { "background", "#fff7e6" }, { "color", "#d9480f" } };
        }
        return null;
    }
