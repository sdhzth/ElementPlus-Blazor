@page "/table"
@inherits ElementDialogBase

<h1 class="demo-page-title">ElTable 进阶：可编辑表格 & 自定义模板列</h1>
<p class="demo-page-sub">
    ElTable 自带行内编辑能力（<code>IsEditable</code>）；单元格渲染则可完全交给 <code>ChildContent</code> / <code>ElTableTemplateColumn</code> 接管。本页两个 demo 分开演示。
</p>

<div class="demo-section">
    <h3>① 可编辑表格（IsEditable + OnSave）</h3>
    <p class="demo-page-sub">
        <b>编辑</b>：<kbd>双击</kbd>某一行进入编辑（或点「操作」列的「编辑」按钮），改完后点该行「操作」列的<b>保存</b>提交；<kbd>Enter</kbd> 在可编辑单元格之间移动，不会触发保存。
        <b>新增</b>：填写表体最后一行的输入框，点「保存」提交 —— <b>请把可编辑列都填齐全</b>（留空的数值列在转换时会抛异常）。
        <br />
        <b>单元格编辑器</b>：默认按属性类型推断（string/数字→<code>ElInput</code>、bool→<code>ElSwitch</code>、DateTime→<code>ElDatePicker</code>）；
        也可以在列上用 <code>Editor</code> 显式指定 —— 本页「类别」用 <code>ElSelect</code>、「供应商」用 <code>ElDropDownTableGrow</code>（下拉里是一张带搜索/分页的表格）、「上架时间」用 <code>ElDateTimePicker</code>（日期 + 时间滚轮）。
        「上架时间」还开了 <code>EditorCloseOnDatePick</code>（本库扩展）：日历里点一天就提交并收起面板，不必再点「确定」；不开这个参数时对齐官方 EP —— 点日期即写值但面板留着好继续拨时间。
        <b>删除</b>：「操作」列的「删除」会先弹确认框。
    </p>
    <p class="demo-page-sub">
        组件<b>不会</b>自己改动数据源：编辑值经 <code>OnSave(TableSaveEventArgs)</code> 抛出，本页在回调里按 <code>e.Action</code>（Create / Update / Delete）写回本地列表，再调用表格 <code>Refresh()</code> 重绘。
    </p>

    <CascadingValue Name="Page" Value="this">
        <ElTable @ref="editTable" DataSource="products" IsEditable="true" AutoGenerateColumns="false"
                 HasSelectionColumn="false" Border="true" OnSave="OnProductSave">
            <ElTableColumn Property="Id" Text="ID" Width="60" IsEditable="false" />
            <ElTableColumn Property="Name" Text="名称" Width="150" OnHeaderClick="OnNameHeaderClick" />
            <ElTableColumn Property="Category" Text="类别（ElSelect）" Width="150"
                           Editor="typeof(ElSelect<string>)"
                           EditorDataSource="MockData.Categories"
                           EditorValueField="Value" EditorTextField="Text" />
            <ElTableColumn Property="Supplier" Text="供应商（ElDropDownTableGrow）" Width="190"
                           Editor="typeof(ElDropDownTableGrow)"
                           EditorDataSource="MockData.Suppliers"
                           EditorValueField="Code" EditorTextField="Name">
                <EditorColumns>
                    <ElTableColumn Property="Code" Text="编码" Width="70" />
                    <ElTableColumn Property="Name" Text="供应商" Width="150" />
                    <ElTableColumn Property="Contact" Text="联系人" Width="80" />
                </EditorColumns>
                <ChildContent Context="cellRow">
                    @SupplierDisplayText(cellRow)
                </ChildContent>
            </ElTableColumn>
            <ElTableColumn Property="Price" Text="单价(元)" Width="100" />
            <ElTableColumn Property="Stock" Text="库存" Width="90" />
            <ElTableColumn Property="OnSale" Text="上架" Width="80" />
            <ElTableColumn Property="CreatedAt" Text="上架时间（ElDateTimePicker）" Width="220"
                           Editor="typeof(ElDateTimePicker)" EditorCloseOnDatePick="true" />
        </ElTable>
    </CascadingValue>

    <p class="demo-note">保存结果：@lastAction</p>
    <p class="demo-note">表头点击事件（仅「名称」列设置了 OnHeaderClick）：@headerClickMsg</p>
    <p class="demo-page-sub">当前共 @products.Count 条。</p>
</div>

<div class="demo-section">
    <h3>② 自定义模板列（ChildContent / ElTableTemplateColumn）</h3>
    <p class="demo-page-sub">
        任意 <code>ElTableColumn</code> 都能写 <code>ChildContent</code> 来接管<b>显示</b>（<code>@@context</code> 是当前行对象）；不需要绑定字段的纯展示列用 <code>ElTableTemplateColumn</code>（无需 <code>Property</code>）。
        下面演示：双行复合单元格、金额格式化 + 右对齐、库存进度条 + 阈值配色、状态标签，以及带按钮的操作列。
    </p>

    <ElTable DataSource="rows" AutoGenerateColumns="false" HasSelectionColumn="false" Border="true">
        <ElTableColumn Type="index" Text="#" Width="60" />
        <ElTableColumn Property="Name" Text="名称（复合单元格）" Width="230">
            <div>
                <div style="font-weight:600;">@(((Product)context).Name)</div>
                <div style="font-size:12px;color:#909399;">@(((Product)context).Category) · @(((Product)context).CreatedAt.ToString("yyyy-MM-dd"))</div>
            </div>
        </ElTableColumn>
        <ElTableColumn Property="Price" Text="单价" Width="120" Align="right">
            <span style="font-variant-numeric:tabular-nums;">¥ @(((Product)context).Price.ToString("N2"))</span>
        </ElTableColumn>
        <ElTableColumn Property="Stock" Text="库存（进度条）" Width="190">
            @{
                var stockRow = (Product)context;
                <div style="display:flex;align-items:center;">
                    <div style="flex:1;height:6px;background:#ebeef5;border-radius:3px;overflow:hidden;margin-right:8px;">
                        <div style="height:100%;width:@BarWidth(stockRow.Stock)%;background:@BarColor(stockRow.Stock);"></div>
                    </div>
                    <span style="min-width:44px;text-align:right;">@stockRow.Stock</span>
                </div>
            }
        </ElTableColumn>
        <ElTableColumn Property="OnSale" Text="状态（条件渲染）" Width="130">
            @if (((Product)context).OnSale)
            {
                <span style="color:#67c23a;font-weight:600;">✓ 在售</span>
            }
            else
            {
                <span style="color:#909399;">— 下架</span>
            }
        </ElTableColumn>
        <ElTableTemplateColumn Text="操作" Width="120">
            @{
                var opRow = (Product)context;
                <ElButton Size="ButtonSize.Small" OnClick="@(e => ShowDetail(opRow))">详情</ElButton>
            }
        </ElTableTemplateColumn>
    </ElTable>

    <p class="demo-note" id="tpl-detail">@detailText</p>
</div>

<DynEditTable />

<div class="demo-section">
    <h3>④ 树形表格（ElTableTreeColumn + 层级数据）</h3>
    <p class="demo-page-sub">
        数据源是一份<b>扁平</b>的层级列表：每个节点带 <code>Id</code> / <code>ParentId</code>，实体继承 <code>ElementPlus.TreeItemBase</code>。
        <code>ElTableTreeColumn</code> 标记「机构 / 科室」为树形列，自动渲染展开箭头、按 <code>Level</code> 缩进；点击箭头可逐层展开 / 折叠。
        下面用「院区 → 学科系统 → 科室 → 病区 / 医疗组」四级结构演示，并提供一键展开 / 折叠。
    </p>

    <div class="demo-toolbar">
        <ElButton Type="ButtonType.Primary" Size="ButtonSize.Small" OnClick="ExpandAll">展开全部</ElButton>
        <ElButton Size="ButtonSize.Small" OnClick="CollapseAll">折叠全部</ElButton>
        <span class="demo-toolbar-status">当前 @orgNodes.Count 个节点</span>
    </div>

    <ElTable @ref="treeTable" DataSource="orgNodes" AutoGenerateColumns="false" HasSelectionColumn="false"
             EnablePagination="false" Border="true">
        <ElTableTreeColumn Property="Name" Text="机构 / 科室（树形列）" Width="260" />
        <ElTableColumn Property="Kind" Text="类别" Width="110" />
        <ElTableColumn Property="Director" Text="负责人" Width="120" />
        <ElTableColumn Property="Capacity" Text="床位/编制" Width="120" Align="right">
            @{
                var capNode = (OrgNode)context;
            }
            @(capNode.Capacity > 0 ? capNode.Capacity.ToString() : "—")
        </ElTableColumn>
        <ElTableColumn Property="Status" Text="状态" Width="120">
            @{
                var stNode = (OrgNode)context;
                var stColor = stNode.Status == "满员" ? "#f56c6c" : stNode.Status == "停诊" ? "#909399" : "#67c23a";
            }
            <span style="color:@stColor;font-weight:600;">@stNode.Status</span>
        </ElTableColumn>
    </ElTable>
</div>

<div class="demo-section">
    <h3>⑤ 操作列置顶（SortNo） + 获取当前行记录</h3>
    <p class="demo-page-sub">
        操作列想排到最前面，只要给它一个<b>最小</b>的 <code>SortNo</code>（如 <code>-1</code>）—— 组件渲染前会按 <code>SortNo</code> 升序排列所有列，跟标签写在哪无关（对比本节 ID / 名称等列都写在它后面，但操作列仍排第一）。
        拿当前行记录有两种现成通道，本表同时演示：<b>① 模板列里的 <code>@@context</code></b> 就是当前行对象（强转后用）；<b>② 点任意单元格触发 <code>RowClick</code> 事件</b>，参数即整行对象。
        按钮点击已调用 <code>StopPropagation()</code>，避免和 <code>RowClick</code> 冒泡打架。
    </p>

    <ElTable DataSource="opRows" AutoGenerateColumns="false" HasSelectionColumn="false"
             Border="true" RowClick="@(r => OnOpRowClick((Product)r))">
        <!-- 操作列：SortNo 最小 → 排第一列（即使写在其它列之后也不影响） -->
        <ElTableTemplateColumn Text="操作" Width="160" SortNo="-1">
            @{
                var r = (Product)context;
                <span class="op-cell" @onclick="e => { }" @onclick:stopPropagation>
                    <ElButton Size="ButtonSize.Small" Type="ButtonType.Primary"
                              OnClick="@(() => OpEdit(r))">编辑</ElButton>
                    <ElButton Size="ButtonSize.Small" Type="ButtonType.Danger"
                              OnClick="@(() => OpDelete(r))">删除</ElButton>
                </span>
            }
        </ElTableTemplateColumn>
        <ElTableColumn Property="Id" Text="ID" Width="60" />
        <ElTableColumn Property="Name" Text="名称" Width="160" />
        <ElTableColumn Property="Category" Text="类别" Width="140" />
        <ElTableColumn Property="Price" Text="单价" Width="110" Align="right">
            <span>¥@(((Product)context).Price.ToString("N2"))</span>
        </ElTableColumn>
        <ElTableColumn Property="Stock" Text="库存" Width="90" />
    </ElTable>

    <p class="demo-note" id="op-detail">@opDetailText</p>
</div>

<div class="demo-section">
    <h3>⑥ 树形表格 + 分页（按顶层节点分页）</h3>
    <p class="demo-page-sub">
        树形表格同样可以分页。本库采用<b>「按顶层节点分页」</b>策略：<code>PageSize</code> 表示每页包含的<b>顶层（ParentId==0）节点数</b>，
        某个顶层节点被展开后，它的子节点会<b>就地显示在同一页</b>（不会把父子拆到两页）；分页器总数 <code>Total</code> 传「顶层节点数」即可。
        下面用 9 个一级科室（每页 3 个 → 共 3 页）演示；切换页码看顶层节点轮换，展开某个科室后其子病区留在当前页。
    </p>

    <div class="demo-toolbar">
        <ElButton Type="ButtonType.Primary" Size="ButtonSize.Small" OnClick="ExpandAllDept">展开全部</ElButton>
        <ElButton Size="ButtonSize.Small" OnClick="CollapseAllDept">折叠全部</ElButton>
        <span class="demo-toolbar-status">顶层节点 @deptRootCount 个 · 当前第 @deptTable?.CurrentPage 页 · 本页可见 @deptVisibleCount 行</span>
    </div>

    <ElTable @ref="deptTable" DataSource="deptNodes" AutoGenerateColumns="false" HasSelectionColumn="false"
             Border="true" EnablePagination="true" PageSize="@deptPageSize" Total="@deptRootCount"
             CurrentPageChanged="@(_ => StateHasChanged())">
        <ElTableTreeColumn Property="Name" Text="一级科室 / 亚专业（树形列）" Width="260" />
        <ElTableColumn Property="Kind" Text="类别" Width="110" />
        <ElTableColumn Property="Director" Text="负责人" Width="120" />
        <ElTableColumn Property="Capacity" Text="床位/编制" Width="120" Align="right">
            @{
                var capD = (OrgNode)context;
            }
            @(capD.Capacity > 0 ? capD.Capacity.ToString() : "—")
        </ElTableColumn>
        <ElTableColumn Property="Status" Text="状态" Width="120">
            @{
                var stD = (OrgNode)context;
                var stColorD = stD.Status == "满员" ? "#f56c6c" : stD.Status == "停诊" ? "#909399" : "#67c23a";
            }
            <span style="color:@stColorD;font-weight:600;">@stD.Status</span>
        </ElTableColumn>
    </ElTable>
</div>

<div class="demo-section" id="sec-table-carousel">
    <h3>⑦ 表格列内嵌入 ElCarousel（影像 / 报告轮播）</h3>
    <p class="demo-page-sub">
        单元格里同样可以放完整组件：<code>ElTableTemplateColumn</code> 的 <code>@@context</code> 是当前行对象，
        直接在里面放一个 <code>ElCarousel</code> + 若干 <code>ElCarouselItem</code> 即可 ——
        <b>每个单元格都是一个独立实例</b>（各自计时、互不干扰，因此在行里放轮播是安全的）。
        本列用 <code>Arrow="CarouselArrow.Hover"</code>，所以<b>鼠标移到哪个单元格，哪个单元格的箭头才出现</b>；
        <code>ImageFit="CarouselImageFit.Contain"</code> 让图片完整显示、不裁掉边缘的信息。
        已开启 <code>PreviewOnClick="true"</code>，<b>单击（或双击）轮播项内的图片即弹出内置 lightbox 放大</b>；
        双击被限制在轮播项内部，不会冒泡到表格行、误触发行的「双击进入编辑」。
    </p>

    <ElTable DataSource="scans" AutoGenerateColumns="false" HasSelectionColumn="false" Border="true">
        <ElTableColumn Property="PatientName" Text="患者" Width="110" />
        <ElTableColumn Property="StudyDate" Text="检查日期" Width="120" />
        <ElTableColumn Property="Modality" Text="检查类型" Width="130" />
        <ElTableTemplateColumn Text="影像预览（列内走马灯）" Width="300">
            @{
                var scanRow = (ScanItem)context;
            }
            <ElCarousel Height="120px" Arrow="CarouselArrow.Hover" ImageFit="CarouselImageFit.Contain"
                        IndicatorPosition="CarouselIndicatorPosition.Inside" Interval="4000"
                        PreviewOnClick="true" PreviewLoop="true">
                @foreach (var url in scanRow.Images)
                {
                    <ElCarouselItem>
                        <img src="@url" alt="@scanRow.PatientName" />
                    </ElCarouselItem>
                }
            </ElCarousel>
        </ElTableTemplateColumn>
        <ElTableTemplateColumn Text="操作" Width="120">
            @{
                var scanOp = (ScanItem)context;
            }
            <ElButton Size="ButtonSize.Small" OnClick="@(() => ShowScanDetail(scanOp))">查看清单</ElButton>
        </ElTableTemplateColumn>
    </ElTable>

    <p class="demo-note" id="scan-detail">@scanDetailText</p>
</div>

<div class="demo-section" id="sec-carousel-preview">
    <h3>⑧ ElCarousel 图片单击放大 + 编程预览</h3>
    <p class="demo-page-sub">
        给 <code>ElCarousel</code> 加 <code>PreviewOnClick="true"</code> 后，<b>单击轮播项内的图片（URL 或 base64 均可）即弹出内置 lightbox 放大</b>，
        非图片内容（文本/组件）单击无反应；灯箱支持上一张/下一张、循环、ESC 关闭、点遮罩关闭。
        组件会自动收集所有 <code>&lt;img&gt;</code> 地址到 <code>CollectedImages</code> 并通过 <code>PreviewImagesChanged</code> 回调；
        也支持开发者通过 <code>PreviewImages</code> 显式指定图集，或调用 <code>OpenPreviewAsync(图片集合, 起始下标)</code> 编程选择<b>一张或几张</b>放大。
    </p>

    <ElCarousel @ref="previewCarousel" Height="200px" Arrow="CarouselArrow.Hover" ImageFit="CarouselImageFit.Contain"
                PreviewOnClick="true" PreviewLoop="true"
                PreviewImagesChanged="OnPreviewImagesChanged">
        @foreach (var url in previewGallery)
        {
            <ElCarouselItem>
                <img src="@url" alt="影像" />
            </ElCarouselItem>
        }
        <ElCarouselItem>
            <div style="display:flex;align-items:center;justify-content:center;height:100%;color:#909399;">本项不是图片，单击不会放大</div>
        </ElCarouselItem>
    </ElCarousel>

    <div class="demo-row">
        <ElButton Size="ButtonSize.Small" OnClick="@(() => previewCarousel.OpenPreviewAsync(0))">编程放大第 1 张</ElButton>
        <ElButton Size="ButtonSize.Small" OnClick="@(() => previewCarousel.OpenPreviewAsync(new[] { previewGallery[1], previewGallery[3] }, 0))">只放大第 2、4 张</ElButton>
        <ElButton Size="ButtonSize.Small" OnClick="@(() => previewCarousel.OpenPreviewAsync(previewGallery, previewGallery.Count - 1))">放大全部（从最后一张开始）</ElButton>
    </div>
    <p class="demo-note">已自动收集 @previewCollected.Count 张图片：@string.Join("、", previewCollected.Select(x => x?.Replace("/images/demo-img-", "").Replace(".svg", "") ?? "—"))</p>
</div>

<div class="demo-section" id="sec-fixed-header">
    <h3>⑨ 固定表头 / 流体高度（Height · MaxHeight，滚动不空白）</h3>
    <p class="demo-page-sub">
        设 <code>Height</code> → 表头固定、表体独立滚动；设 <code>MaxHeight</code> → 高度随内容增长，到顶才开始滚（EP 的「流体高度」）。
        横向滚动由 <code>dom.js</code> 的 <code>elementTableSyncScroll</code> <b>纯 JS 镜像</b>表头位置，
        <b>滚动期间完全不进 Blazor 渲染管线</b>（此前用 <code>@@onscroll</code> 绑定：每滚一次都要整表重渲染一遍，行多时就是「先空白停滞一下再显示」）。
        下面左表固定高度 <b>260px</b>、右表最大高度 <b>320px</b>，各 <b>@fixedRows.Count</b> 行。
    </p>

    <div class="demo-split-2">
        <div>
            <p class="demo-note">固定表头（<code>Height="260"</code>）</p>
            <ElTable DataSource="fixedRows" Height="260" Border="true" Stripe="true"
                     HasSelectionColumn="false" AutoGenerateColumns="false" EnablePagination="false">
                <ElTableColumn Property="Id" Text="ID" Width="70" Align="right" />
                <ElTableColumn Property="Name" Text="名称" Width="200" />
                <ElTableColumn Property="Category" Text="类别" Width="130" />
                <ElTableColumn Property="Price" Text="单价(元)" Width="110" Align="right" />
                <ElTableColumn Property="Stock" Text="库存" Width="100" Align="right" />
            </ElTable>
        </div>
        <div>
            <p class="demo-note">流体高度（<code>MaxHeight="320"</code>，行数少时不锁高）</p>
            <ElTable DataSource="@fixedRows.Take(12).ToList()" MaxHeight="320" Border="true"
                     HasSelectionColumn="false" AutoGenerateColumns="false" EnablePagination="false">
                <ElTableColumn Property="Id" Text="ID" Width="70" Align="right" />
                <ElTableColumn Property="Name" Text="名称" Width="200" />
                <ElTableColumn Property="Category" Text="类别" Width="130" />
                <ElTableColumn Property="Price" Text="单价(元)" Width="110" Align="right" />
                <ElTableColumn Property="Stock" Text="库存" Width="100" Align="right" />
            </ElTable>
        </div>
    </div>
</div>

<div class="demo-section" id="sec-ep-features">
    <h3>⑩ EP 进阶能力：合计行 / 单元格合并 / 默认排序 / 实例方法</h3>
    <p class="demo-page-sub">
        本表一次性演示四个官方对齐能力：
        <b>合计行</b>（<code>ShowSummary</code> + <code>SumText</code>：数值列自动求和，首列显示「合计」）；
        <b>单元格合并</b>（<code>SpanMethod</code>：名称列每两行纵向合并一次）；
        <b>默认排序</b>（<code>DefaultSortProp="Stock"</code> 升序，首次加载即按库存排序）；
        <b>实例方法</b>：下方按钮分别调用 <code>ClearSelectionAsync()</code> / <code>SetCurrentRow()</code> / <code>SetScrollTopAsync()</code>。
        「高亮第 1 行」取的是 <code>VisibleRows[0]</code>（<b>显示</b>的第 1 行，已按默认排序重排）——
        若按数据源下标取 <code>epRows[0]</code>，它会排到第 31 行、在 260px 定高表体外面，点了像没反应。
    </p>

    <div class="demo-toolbar">
        <ElButton Size="ButtonSize.Small" OnClick="@(() => epTable?.ClearSelectionAsync())">清空选择</ElButton>
        <ElButton Size="ButtonSize.Small" OnClick="@(() => epTable?.SetCurrentRow(epTable.VisibleRows.FirstOrDefault()))">高亮第 1 行</ElButton>
        <ElButton Size="ButtonSize.Small" OnClick="@(() => epTable?.SetScrollTopAsync(0))">滚动到顶部</ElButton>
    </div>

    <ElTable @ref="epTable" DataSource="epRows" Height="260" Border="true" Stripe="true"
             HasSelectionColumn="true" AutoGenerateColumns="false" EnablePagination="false"
             ShowSummary="true" SumText="合计"
             HighlightCurrentRow="true"
             DefaultSortProp="Stock" DefaultSortOrder="TableSortOrder.Ascending"
             SpanMethod="EpSpanMethod">
        <ElTableColumn Property="Id" Text="ID" Width="70" Align="right" />
        <ElTableColumn Property="Name" Text="名称（每2行合并）" Width="200" />
        <ElTableColumn Property="Category" Text="类别" Width="130" />
        <ElTableColumn Property="Price" Text="单价(元)" Width="110" Align="right" />
        <ElTableColumn Property="Stock" Text="库存" Width="100" Align="right" />
    </ElTable>

    <p class="demo-note" id="ep-status">@epStatus</p>
</div>

@* ⑪ 段整体搬到 HeaderMenuDemo 组件：菜单状态挂在页面上时，点列头会连带重渲染整页 12 段
