    // ===== ⑥ 树形表格 + 分页 =====

    /// <summary>⑥ 用多个顶层节点（一级科室）演示树形 + 分页：每页 3 个顶层节点。</summary>
    private List<OrgNode> deptNodes = BuildDeptTree();
    private ElTable deptTable;
    private int deptPageSize = 3;
    private int deptRootCount => deptNodes.Count(x => x.ParentId == 0);
    private int deptVisibleCount => deptTable?.VisibleRowCount ?? 0;

    /// <summary>构建 9 个一级科室（顶层根），每个带 2~3 个亚专业 / 病区，共约 30 个节点。</summary>
    private static List<OrgNode> BuildDeptTree()
    {
        var list = new List<OrgNode>();
        var id = 0;
        OrgNode Add(string name, string kind, string director, int capacity, string status, int parentId, bool hasChildren = false)
        {
            var node = new OrgNode
            {
                Id = ++id,
                ParentId = parentId,
                Name = name,
                Kind = kind,
                Director = director,
                Capacity = capacity,
                Status = status,
                HasChildren = hasChildren
            };
            list.Add(node);
            return node;
        }

        // 9 个一级科室（顶层根）。HasChildren 一律不手写，末尾按 ParentId 反推（见下方注释）。
        var a = Add("内科", "一级科室", "李主任", 0, "正常", 0);
        var cardio = Add("心血管内科", "亚专业", "张文博", 60, "满员", a.Id);
        Add("心血管一病区", "病区", "赵护士长", 30, "正常", cardio.Id);
        Add("呼吸内科", "亚专业", "孙呼吸", 50, "正常", a.Id);

        var b = Add("外科", "一级科室", "吴主任", 0, "正常", 0);
        var general = Add("普外科", "亚专业", "郑普外", 55, "正常", b.Id);
        Add("胃肠外科组", "医疗组", "王胃肠", 20, "正常", general.Id);
        Add("肝胆外科组", "医疗组", "冯肝胆", 18, "正常", general.Id);

        var c = Add("妇产科", "一级科室", "何主任", 0, "正常", 0);
        Add("妇科", "亚专业", "许妇科", 40, "正常", c.Id);
        var obstetric = Add("产科", "亚专业", "施产科", 45, "满员", c.Id);
        Add("产房", "病区", "曹助产", 15, "正常", obstetric.Id);

        var d = Add("儿科", "一级科室", "朱主任", 0, "正常", 0);
        var neonatal = Add("新生儿科", "亚专业", "秦新生", 30, "正常", d.Id);
        Add("NICU", "病区", "尤监护", 10, "满员", neonatal.Id);
        Add("普儿病区", "病区", "吕普儿", 25, "正常", d.Id);

        var e = Add("神经内科", "一级科室", "卫主任", 0, "正常", 0);
        Add("脑血管病组", "医疗组", "蒋脑血管", 22, "正常", e.Id);
        Add("癫痫门诊", "亚专业", "沈癫痫", 0, "正常", e.Id);

        var f = Add("心血管科", "一级科室", "韩主任", 0, "正常", 0);
        Add("冠心病组", "医疗组", "杨冠心病", 26, "正常", f.Id);
        Add("心律失常组", "医疗组", "朱心律", 24, "正常", f.Id);

        var g = Add("骨科", "一级科室", "陈主任", 0, "正常", 0);
        Add("脊柱外科组", "医疗组", "褚脊柱", 20, "正常", g.Id);
        Add("关节外科组", "医疗组", "孔关节", 19, "正常", g.Id);

        var h = Add("眼科", "一级科室", "云主任", 0, "正常", 0);
        Add("白内障组", "医疗组", "金白内障", 16, "正常", h.Id);
        Add("眼底病组", "医疗组", "魏眼底", 14, "正常", h.Id);

        var i = Add("耳鼻喉科", "一级科室", "陶主任", 0, "正常", 0);
        Add("耳科组", "医疗组", "姜耳科", 15, "正常", i.Id);
        Add("鼻科组", "医疗组", "戚鼻科", 13, "正常", i.Id);

        // HasChildren 由 ParentId 反推，不留手抄的空间：这一列以前给 4 个叶子节点（心血管内科 / 普外科 /
        // 产科 / 新生儿科）写了 true，而它们的「孩子」实际挂在祖父节点上 —— 于是那 4 行的箭头点了没反应
        // （用户 2026-10-10 截图指的就是这种行）。三层链（一级科室 → 亚专业 → 病区/医疗组）顺带补上，
        // 让「分页 × 多层展开」这条路径真有样本。
        var parentIds = new HashSet<int>(list.Where(x => x.ParentId != 0).Select(x => x.ParentId));
        foreach (var node in list)
        {
            node.HasChildren = parentIds.Contains(node.Id);
        }

        return list;
    }

