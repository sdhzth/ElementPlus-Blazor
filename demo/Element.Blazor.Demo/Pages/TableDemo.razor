    /// <summary>⑩ span-method 演示：名称列（0 下标）每两行纵向合并一次；其余列不合并。</summary>
    private (int Rowspan, int Colspan) EpSpanMethod(object row, TableHeader header, int rowIndex, int columnIndex)
    {
        if (columnIndex == 0)
        {
            return rowIndex % 2 == 0 ? (2, 1) : (0, 0);
        }
        return (1, 1);
    }

    // 用本地副本，避免编辑操作污染其他页面的共享 Mock 数据
    private List<Product> products = MockData.Products.Select(p => new Product
    {
        Id = p.Id,
