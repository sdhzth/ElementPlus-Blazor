    // ⑩ EP 进阶能力演示数据：独立副本、唯一 Id，避免行 key 冲突
    private ElTable epTable;
    private string epStatus = "（尚未调用实例方法）";
    private List<Product> epRows = Enumerable.Range(0, 60).Select(i =>
