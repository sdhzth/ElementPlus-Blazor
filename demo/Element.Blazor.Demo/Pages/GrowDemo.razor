    // ---------------- OFD 预览示例 ----------------
    // 演示两种取文档的方式：
    //   1) URL（Src / FromUrl）—— 最贴近「打开一份 OFD」；由内置通道自己 fetch。
    //   2) 字节（Content / FromBytes）—— 宿主用 HttpClient 取流后交给组件（可自带鉴权头）。
    //
    // 注意样例文件的扩展名是 .ofd.bin 而不是 .ofd：.NET 开发服务器（以及不少生产 Web 服务器）
    // 只服务 MIME 表里认识的扩展名，未登记的扩展名会直接 404。文件的实际类型靠 FileName 告诉
    // 组件（Kind 由 FileName / ContentType 判定，不看 URL 后缀）。部署时给 .ofd 配上
    // application/ofd 就能直接用 .ofd 后缀。
    private sealed class OfdSample
    {
        public string Label { get; set; }
        public string Url { get; set; }
        public string FileName { get; set; }
    }

    private static readonly OfdSample[] ofdSamples =
    {
        new OfdSample { Label = "出院小结", Url = "/ofd/out.ofd.bin", FileName = "out.ofd" },
        new OfdSample { Label = "字体样式（2 页）", Url = "/ofd/font-styles.ofd.bin", FileName = "font-styles.ofd" },
        new OfdSample { Label = "多行样式", Url = "/ofd/MultiSpanStyles.ofd.bin", FileName = "MultiSpanStyles.ofd" },
        new OfdSample { Label = "综合样例", Url = "/ofd/multi_demo.ofd.bin", FileName = "multi_demo.ofd" },
        new OfdSample { Label = "信息卡片", Url = "/ofd/modern-info-card.ofd.bin", FileName = "modern-info-card.ofd" },
        // HCView 6.8 生成的 OFD-H 护理记录单：横向 297x210 单页、每个 XML 前面带 UTF-8 BOM、
        // 命名空间写成 http://www.ofdspec.org（没有 /2016 后缀）、且整个包没有签名层。
        // 这份是"第三方生成器的常见写法也能打开"的证人，改动渲染核心时它会先红。
        new OfdSample { Label = "护理记录单（OFD-H）", Url = "/ofd/hcview.ofd.bin", FileName = "hcview.ofd" },
        // 住院病案首页 OFD-H（GB/T 48666—2026 口径）：3 页、210x297 竖版、Signatures 走 Loc 属性、
        // 签名与注释层用默认命名空间、页面里 87 个 PathObject 没有 Boundary —— 三种写法都曾让渲染
        // 核心整份文档报失败。这份是用户原文件的等观感副本（两份 10.5 MB 的仿宋字稿只留 4 KB 表头，
        // 渲染读数逐字相同：3 页 / 1367 字 / 87 条 path / 169 个 svg），正文本身是演示数据。
        new OfdSample { Label = "病案首页（OFD-H）", Url = "/ofd/ofd-h-case-page.ofd.bin", FileName = "ofd-h-case-page.ofd" },
    };

    private ElViewerDocument ofdDocument = ElViewerDocument.FromUrl(ofdSamples[0].Url, ofdSamples[0].FileName);
    private string ofdActive = ofdSamples[0].Label;
    private string ofdLoadNote;
    private string ofdReadyNote;
    private int ofdKey;

    /// <summary>加载方式 + 渲染结果合成一句提示（两份信息互不覆盖）。</summary>
    private string ofdNote => string.Join("　", new[] { ofdLoadNote, ofdReadyNote }.Where(x => !string.IsNullOrEmpty(x)));

    private void SelectOfdSample(OfdSample sample)
    {
        ofdDocument = ElViewerDocument.FromUrl(sample.Url, sample.FileName);
        ofdActive = sample.Label;
        ofdLoadNote = $"当前文档：{sample.FileName}（由 URL 加载）";
        ofdReadyNote = null;

        // 换文档时换 key，强制组件重建，避免复用上一份文档的挂载状态。
        ofdKey++;
    }

    /// <summary>按字节加载：走 HttpClient 取流后交给组件（宿主侧抓字节的标准写法）。</summary>
    private async Task LoadOfdFromBytesAsync()
    {
        const string url = "/ofd/out.ofd.bin";

        try
        {
            var bytes = await Http.GetByteArrayAsync(url);

            ofdDocument = ElViewerDocument.FromBytes(bytes, "out.ofd");
            ofdActive = "按字节加载";
            ofdLoadNote = $"已用 HttpClient 取到 {bytes.Length} 字节，交由内置通道渲染。";
            ofdReadyNote = null;
            ofdKey++;
        }
        catch (Exception exception)
        {
            ofdLoadNote = "取流失败：" + exception.Message;
            ofdReadyNote = null;
        }
    }

    /// <summary>把内置通道解析出的页数写进提示，便于确认渲染确实成功了。</summary>
    private void OnOfdStatusChanged(ElViewerStateChangedEventArgs args)
    {
        if (args.Status == ElViewerStatus.Ready && args.PageCount > 0)
        {
            ofdReadyNote = $"{ofdActive}　渲染完成：共 {args.PageCount} 页。";
        }
        else if (args.Status == ElViewerStatus.Error)
        {
            ofdReadyNote = $"{ofdActive}　渲染失败：{args.Message}";
        }
    }

    // ---------------- Office 预览示例 ----------------
    // Office 渲染必须在 C# 侧拿到字节（组件用 ZipArchive 直接解压解析），
    // 所以演示一律走 HttpClient 取流 → FromBytes，与 OFD（可只给 URL）不同。
    private sealed class OfficeSample
    {
        public string Label { get; set; }
        public string Url { get; set; }
        public string FileName { get; set; }
    }

    private static readonly OfficeSample[] officeSamples =
    {
        new OfficeSample { Label = "Word 文档", Url = "/samples/office-sample.docx", FileName = "office-sample.docx" },
        new OfficeSample { Label = "Excel 表格", Url = "/samples/office-sample.xlsx", FileName = "office-sample.xlsx" },
        new OfficeSample { Label = "PPT 演示", Url = "/samples/office-sample.pptx", FileName = "office-sample.pptx" },
        new OfficeSample { Label = "PDF 文档", Url = "/samples/office-sample.pdf", FileName = "office-sample.pdf" },
    };

    // 初始不挂文档（null → 空态）；OnInitializedAsync 会拉第一份，避免一开始显示「不支持」。
    private ElViewerDocument officeDocument;
    private string officeActive = "Word 文档";
    private string officeLoadNote;
    private string officeReadyNote;
    private int officeKey;

    // HiddenTools 演示：勾上后工具栏的打印 / 下载按钮整体移除（不是禁用）。
    private bool officeHideButtons;

    /// <summary>加载方式 + 渲染结果合成一句提示（两份信息互不覆盖）。</summary>
    private string officeNote => string.Join("　", new[] { officeLoadNote, officeReadyNote }.Where(x => !string.IsNullOrEmpty(x)));

    /// <summary>按字节加载：Office 必须拿到字节，组件才能用内建 OOXML 解析器渲染。</summary>
    private async Task LoadOfficeSampleAsync(OfficeSample sample)
    {
        try
        {
            var bytes = await Http.GetByteArrayAsync(sample.Url);

            officeDocument = ElViewerDocument.FromBytes(bytes, sample.FileName);
            officeActive = sample.Label;
            officeLoadNote = $"已用 HttpClient 取到 {bytes.Length} 字节，交由内建 OOXML 解析器渲染。";
            officeReadyNote = null;
            officeKey++;
        }
        catch (Exception exception)
        {
            officeLoadNote = "取流失败：" + exception.Message;
            officeReadyNote = null;
        }
    }

    /// <summary>旧版 .doc（OLE 复合文档）：内建解析器读不了，组件给出「另存为新格式」的可执行提示。</summary>
    private async Task LoadLegacyDocAsync()
    {
        const string url = "/samples/office-legacy.doc";

        try
        {
            var bytes = await Http.GetByteArrayAsync(url);

            officeDocument = ElViewerDocument.FromBytes(bytes, "office-legacy.doc");
            officeActive = "旧版 .doc";
            officeLoadNote = $"已取到 {bytes.Length} 字节，但这不是 OOXML（是 OLE 复合文档），内建解析器无法读取。";
            officeReadyNote = null;
            officeKey++;
        }
        catch (Exception exception)
        {
            officeLoadNote = "取流失败：" + exception.Message;
            officeReadyNote = null;
        }
    }

    /// <summary>把内建解析结果写进提示（Office 是纯 C# 同步渲染，Ready 即解析完成）。</summary>
    private void OnOfficeStatusChanged(ElViewerStateChangedEventArgs args)
    {
        if (args.Status == ElViewerStatus.Ready)
        {
            officeReadyNote = $"{officeActive}　渲染完成（内建 OOXML 解析）。";
        }
        else if (args.Status == ElViewerStatus.Unsupported)
        {
            officeReadyNote = $"{officeActive}　无法渲染：{args.Message}";
        }
        else if (args.Status == ElViewerStatus.Error)
        {
            officeReadyNote = $"{officeActive}　渲染失败：{args.Message}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadOfficeSampleAsync(officeSamples[0]);
    }

