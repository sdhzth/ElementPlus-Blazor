@using System.Linq
@using System.Collections.ObjectModel
@using ElementPlus.Markdown
@page "/grow"
@inject HttpClient Http
@using System.Threading
@implements IDisposable

<h1 class="demo-page-title">自研 / Grow 组件（带 Mock 数据）</h1>
<p class="demo-page-sub">
    透视表、图表、热力图、文档预览、富文本编辑器、下拉表格、条码、二维码、Markdown、表单字段、对话框
    均为本仓库自渲染实现，不引入任何第三方 UI 组件库。
</p>

<div class="demo-section">
    <h3>ElPivotDataGridGrow 透视表（订单 Mock 数据）</h3>
    @if (builtSections > 0)
    {
    <ElPivotDataGridGrow TItem="MockData.Order" Data="MockData.Orders" AllowPaging="true" ShowColumnsTotals="true">
        <Columns>
            <ElPivotColumnGrow TItem="MockData.Order" Property="Region" Title="区域" />
            <ElPivotColumnGrow TItem="MockData.Order" Property="Year" Title="年份" />
        </Columns>
        <Rows>
            <ElPivotRowGrow TItem="MockData.Order" Property="Category" Title="品类" />
            <ElPivotRowGrow TItem="MockData.Order" Property="Product" Title="商品" />
        </Rows>
        <Aggregates>
            <ElPivotAggregateGrow TItem="MockData.Order" Property="Amount" Title="金额" Aggregate="ElPivotAggregateFunction.Sum" FormatString="N2" />
        </Aggregates>
    </ElPivotDataGridGrow>
    }
</div>

<div class="demo-section">
    <h3>ElChartGrow 图表（销量 Mock 数据）</h3>
    @if (builtSections > 1)
    {
    <ElChartGrow Title="月度销量" Width="640" Height="320" Cls="demo-chart-basic">
        <ElChartSeries Items="MockData.SalesPoints" CategoryField="Category" ValueField="Value" Title="销量" ChartType="ElChartType.Column" />
    </ElChartGrow>
    }
</div>

<div class="demo-section">
    <h3>ElChartGrow 金融 / 统计 / 范围 / 流程族（新增 19 种序列类型）</h3>
    @if (builtSections > 2)
    {
    <p class="demo-page-sub">
        全部由 <code>ElChartGrowEngine</code> 在 C# 侧算出几何并输出 SVG，不引入任何第三方图表库。
        多值系列统一走「5 个数值槽」模型：既可用语义别名（<code>OpenField</code>/<code>HighField</code>…
        ），也可用通用 <code>ValueField2..5</code>。K 线涨跌色默认中国习惯「涨红跌绿」。
    </p>

    <div class="demo-row" style="align-items:flex-start;flex-wrap:wrap;">
        <ElChartGrow Title="K 线（Candlestick）" Width="420" Height="280" Cls="demo-chart-candle">
            <ElChartSeries Items="MockData.PriceCandles" CategoryField="Category"
                           OpenField="Open" HighField="High" LowField="Low" CloseField="Close"
                           Title="收盘价" ChartType="ElChartType.Candlestick" />
        </ElChartGrow>

        <ElChartGrow Title="OHLC 图" Width="420" Height="280" Cls="demo-chart-ohlc">
            <ElChartSeries Items="MockData.PriceCandles" CategoryField="Category"
                           OpenField="Open" HighField="High" LowField="Low" CloseField="Close"
                           Title="开收高低" ChartType="ElChartType.Ohlc" />
        </ElChartGrow>
    </div>

    <div class="demo-row" style="align-items:flex-start;flex-wrap:wrap;">
        <ElChartGrow Title="箱线图（平均住院日分布）" Width="420" Height="280" Cls="demo-chart-boxplot">
            <ElChartSeries Items="MockData.StayBoxes" CategoryField="Category"
                           MinField="Min" Q1Field="Q1" MedianField="Median" Q3Field="Q3" MaxField="Max"
                           Title="住院日" ChartType="ElChartType.BoxPlot" />
        </ElChartGrow>

        <ElChartGrow Title="范围面积（体温区间）" Width="420" Height="280" Cls="demo-chart-rangearea">
            <ElChartSeries Items="MockData.TempRanges" CategoryField="Category"
                           LowField="Low" HighField="High" Title="体温" ChartType="ElChartType.RangeArea" />
        </ElChartGrow>
    </div>

    <div class="demo-row" style="align-items:flex-start;flex-wrap:wrap;">
        <ElChartGrow Title="范围柱状（体温区间）" Width="420" Height="280" Cls="demo-chart-rangecolumn">
            <ElChartSeries Items="MockData.TempRanges" CategoryField="Category"
                           LowField="Low" HighField="High" Title="体温" ChartType="ElChartType.RangeColumn" />
        </ElChartGrow>

        <ElChartGrow Title="范围条形（体温区间）" Width="420" Height="280" Cls="demo-chart-rangebar">
            <ElChartSeries Items="MockData.TempRanges" CategoryField="Category"
                           LowField="Low" HighField="High" Title="体温" ChartType="ElChartType.RangeBar" />
        </ElChartGrow>
    </div>

    <div class="demo-row" style="align-items:flex-start;flex-wrap:wrap;">
        <ElChartGrow Title="瀑布图（门诊收入变化）" Width="420" Height="280" Cls="demo-chart-waterfall">
            <ElChartSeries Items="MockData.RevenueWaterfall" CategoryField="Category"
                           ValueField="Amount" IsTotalField="IsTotal"
                           Title="收支" ChartType="ElChartType.Waterfall" />
        </ElChartGrow>

        <ElChartGrow Title="水平瀑布图" Width="420" Height="280" Cls="demo-chart-hwaterfall">
            <ElChartSeries Items="MockData.RevenueWaterfall" CategoryField="Category"
                           ValueField="Amount" IsTotalField="IsTotal"
                           Title="收支" ChartType="ElChartType.HorizontalWaterfall" />
        </ElChartGrow>
    </div>

    <div class="demo-row" style="align-items:flex-start;flex-wrap:wrap;">
        <ElChartGrow Title="子弹图（KPI 达成）" Width="420" Height="280" Cls="demo-chart-bullet">
            <ElChartSeries Items="MockData.DeptKpi" CategoryField="Category"
                           ValueField="Actual" TargetField="Target"
                           Title="实际 / 目标" ChartType="ElChartType.Bullet" />
        </ElChartGrow>

        <ElChartGrow Title="高低图（HighLow）" Width="420" Height="280" Cls="demo-chart-highlow">
            <ElChartSeries Items="MockData.PriceCandles" CategoryField="Category"
                           HighField="High" LowField="Low" CloseField="Close"
                           Title="高低收" ChartType="ElChartType.HighLow" />
        </ElChartGrow>
    </div>

    <div class="demo-row" style="align-items:flex-start;flex-wrap:wrap;">
        <ElChartGrow Title="100% 堆叠柱（占比）" Width="420" Height="280" Cls="demo-chart-fullstacked">
            <ElChartSeries Items="MockData.SalesPoints" CategoryField="Category" ValueField="Value" Title="线上" ChartType="ElChartType.FullStackedColumn" />
            <ElChartSeries Items="MockData.SalesPointsB" CategoryField="Category" ValueField="Value" Title="线下" ChartType="ElChartType.FullStackedColumn" />
        </ElChartGrow>

        <ElChartGrow Title="漏斗图" Width="420" Height="280" Cls="demo-chart-funnel">
            <ElChartSeries Items="MockData.SalesPoints" CategoryField="Category" ValueField="Value" Title="漏斗" ChartType="ElChartType.Funnel" />
        </ElChartGrow>
    </div>

    <div class="demo-row" style="align-items:flex-start;flex-wrap:wrap;">
        <ElChartGrow Title="金字塔图" Width="420" Height="280" Cls="demo-chart-pyramid">
            <ElChartSeries Items="MockData.SalesPoints" CategoryField="Category" ValueField="Value" Title="金字塔" ChartType="ElChartType.Pyramid" />
        </ElChartGrow>

        <ElChartGrow Title="蜘蛛柱状图（SpiderColumn）" Width="420" Height="280" Cls="demo-chart-spider">
            <ElChartSeries Items="MockData.SalesPoints" CategoryField="Category" ValueField="Value" Title="指标" ChartType="ElChartType.SpiderColumn" />
        </ElChartGrow>
    </div>

    <div class="demo-row" style="align-items:flex-start;flex-wrap:wrap;">
        <ElChartGrow Title="热力图（门诊量）" Width="420" Height="280" Cls="demo-chart-heatmap">
            <ElChartSeries Items="MockData.OutpatientHeat" CategoryField="Cell" GroupField="Slot" ValueField="Count" Title="门诊量" ChartType="ElChartType.Heatmap" />
        </ElChartGrow>

        <ElChartGrow Title="等值带图（Contour）" Width="420" Height="280" Cls="demo-chart-contour">
            <ElChartSeries Items="MockData.OutpatientHeat" CategoryField="Cell" GroupField="Slot" ValueField="Count" Title="门诊量" ChartType="ElChartType.Contour" />
        </ElChartGrow>
    </div>
    }
</div>

<div class="demo-section">
    <h3>ElChartGrow 标准型序列（Bar / 散点 / 气泡 / 饼 / 环 / 雷达 / 堆叠族 / 100% 堆叠族）</h3>
    @if (builtSections > 3)
    {
    <p class="demo-page-sub">
        这一组覆盖 <code>ElChartType</code> 中「先有的标准型」，与上一组新增的 19 种合起来让 <code>/grow</code> 覆盖全部 32 种序列。
    </p>

    <div class="demo-row" style="align-items:flex-start;flex-wrap:wrap;">
        <ElChartGrow Title="条形图（Bar）" Width="420" Height="280" Cls="demo-chart-bar">
            <ElChartSeries Items="MockData.SalesPoints" CategoryField="Category" ValueField="Value" Title="销量" ChartType="ElChartType.Bar" />
        </ElChartGrow>

        <ElChartGrow Title="散点图（Scatter，数值 X 轴）" Width="420" Height="280" Cls="demo-chart-scatter">
            <ElChartSeries Items="MockData.ScatterPoints" XValueField="X" ValueField="Y" Title="样本" ChartType="ElChartType.Scatter" />
        </ElChartGrow>
    </div>

    <div class="demo-row" style="align-items:flex-start;flex-wrap:wrap;">
        <ElChartGrow Title="气泡图（Bubble，Size 为第三维）" Width="420" Height="280" Cls="demo-chart-bubble">
            <ElChartSeries Items="MockData.ScatterPoints" XValueField="X" ValueField="Y" SizeField="Size" Title="样本" ChartType="ElChartType.Bubble" />
        </ElChartGrow>

        <ElChartGrow Title="饼图（Pie）" Width="420" Height="280" Cls="demo-chart-pie">
            <ElChartSeries Items="MockData.SalesPoints" CategoryField="Category" ValueField="Value" Title="销量" ChartType="ElChartType.Pie" />
        </ElChartGrow>
    </div>

    <div class="demo-row" style="align-items:flex-start;flex-wrap:wrap;">
        <ElChartGrow Title="环图（Donut）" Width="420" Height="280" Cls="demo-chart-donut">
            <ElChartSeries Items="MockData.SalesPoints" CategoryField="Category" ValueField="Value" Title="销量" ChartType="ElChartType.Donut" />
        </ElChartGrow>

        <ElChartGrow Title="雷达图（Radar）" Width="420" Height="280" Cls="demo-chart-radar">
            <ElChartSeries Items="MockData.SalesPoints" CategoryField="Category" ValueField="Value" Title="销量" ChartType="ElChartType.Radar" />
        </ElChartGrow>
    </div>

    <div class="demo-row" style="align-items:flex-start;flex-wrap:wrap;">
        <ElChartGrow Title="堆叠柱（StackedColumn）" Width="420" Height="280" Cls="demo-chart-stackedcol">
            <ElChartSeries Items="MockData.SalesPoints" CategoryField="Category" ValueField="Value" Title="线上" ChartType="ElChartType.StackedColumn" />
            <ElChartSeries Items="MockData.SalesPointsB" CategoryField="Category" ValueField="Value" Title="线下" ChartType="ElChartType.StackedColumn" />
        </ElChartGrow>

        <ElChartGrow Title="堆叠条（StackedBar）" Width="420" Height="280" Cls="demo-chart-stackedbar">
            <ElChartSeries Items="MockData.SalesPoints" CategoryField="Category" ValueField="Value" Title="线上" ChartType="ElChartType.StackedBar" />
            <ElChartSeries Items="MockData.SalesPointsB" CategoryField="Category" ValueField="Value" Title="线下" ChartType="ElChartType.StackedBar" />
        </ElChartGrow>
    </div>

    <div class="demo-row" style="align-items:flex-start;flex-wrap:wrap;">
        <ElChartGrow Title="堆叠面积（StackedArea）" Width="420" Height="280" Cls="demo-chart-stackedarea">
            <ElChartSeries Items="MockData.SalesPoints" CategoryField="Category" ValueField="Value" Title="线上" ChartType="ElChartType.StackedArea" />
            <ElChartSeries Items="MockData.SalesPointsB" CategoryField="Category" ValueField="Value" Title="线下" ChartType="ElChartType.StackedArea" />
        </ElChartGrow>

        <ElChartGrow Title="堆叠折线（StackedLine）" Width="420" Height="280" Cls="demo-chart-stackedline">
            <ElChartSeries Items="MockData.SalesPoints" CategoryField="Category" ValueField="Value" Title="线上" ChartType="ElChartType.StackedLine" />
            <ElChartSeries Items="MockData.SalesPointsB" CategoryField="Category" ValueField="Value" Title="线下" ChartType="ElChartType.StackedLine" />
        </ElChartGrow>
    </div>

    <div class="demo-row" style="align-items:flex-start;flex-wrap:wrap;">
        <ElChartGrow Title="100% 堆叠条（FullStackedBar）" Width="420" Height="280" Cls="demo-chart-fsbar">
            <ElChartSeries Items="MockData.SalesPoints" CategoryField="Category" ValueField="Value" Title="线上" ChartType="ElChartType.FullStackedBar" />
            <ElChartSeries Items="MockData.SalesPointsB" CategoryField="Category" ValueField="Value" Title="线下" ChartType="ElChartType.FullStackedBar" />
        </ElChartGrow>

        <ElChartGrow Title="100% 堆叠面积（FullStackedArea）" Width="420" Height="280" Cls="demo-chart-fsarea">
            <ElChartSeries Items="MockData.SalesPoints" CategoryField="Category" ValueField="Value" Title="线上" ChartType="ElChartType.FullStackedArea" />
            <ElChartSeries Items="MockData.SalesPointsB" CategoryField="Category" ValueField="Value" Title="线下" ChartType="ElChartType.FullStackedArea" />
        </ElChartGrow>
    </div>

    <div class="demo-row" style="align-items:flex-start;flex-wrap:wrap;">
        <ElChartGrow Title="100% 堆叠折线（FullStackedLine）" Width="420" Height="280" Cls="demo-chart-fsline">
            <ElChartSeries Items="MockData.SalesPoints" CategoryField="Category" ValueField="Value" Title="线上" ChartType="ElChartType.FullStackedLine" />
            <ElChartSeries Items="MockData.SalesPointsB" CategoryField="Category" ValueField="Value" Title="线下" ChartType="ElChartType.FullStackedLine" />
        </ElChartGrow>
    </div>
    }
</div>

<div class="demo-section">
    <h3>ElChartGrow 结构能力：趋势线 / 参考线 / 标注 / 命名次轴 / 悬停提示</h3>
    @if (builtSections > 4)
    {
    <p class="demo-page-sub">
        趋势线支持线性回归、移动平均、二次拟合、均值 / 中位数 / 众数；参考线按数值或类别定位；
        命名次轴让两条量级差 10 倍的序列共用一块画布（主轴量程只统计未绑定次轴的序列）；
        把鼠标移到图上会出十字准线 + 数据点高亮 + HTML 提示框。
    </p>

    <div class="demo-row" style="align-items:flex-start;flex-wrap:wrap;">
        <ElChartGrow Title="折线 + 线性趋势线 + 目标参考线 + 异常点标注"
                     Width="420" Height="280" Cls="demo-chart-trend"
                     ReferenceLines="MockData.SalesReferenceLines"
                     Annotations="@chartAnnotations">
            <ElChartSeries Items="MockData.SalesPoints" CategoryField="Category" ValueField="Value"
                           Title="销量" ChartType="ElChartType.Line"
                           TrendLine="ElTrendLineType.Linear" MarkerType="ElMarkerType.Circle" ShowDataLabels="true" />
        </ElChartGrow>

        <ElChartGrow Title="双坐标轴（柱=销量 / 线=金额，次轴在右）" Width="420" Height="280" Cls="demo-chart-dual">
            <ElChartAxis Type="ElAxisType.Value" Name="revenue" Title="金额" />
            <ElChartSeries Items="MockData.SalesPoints" CategoryField="Category" ValueField="Value" Title="销量" ChartType="ElChartType.Column" />
            <ElChartSeries Items="MockData.RevenuePoints" CategoryField="Category" ValueField="Value"
                           Title="金额" ChartType="ElChartType.Line" ValueAxisName="revenue" MarkerType="ElMarkerType.Square" />
        </ElChartGrow>
    </div>

    <div class="demo-row" style="align-items:flex-start;flex-wrap:wrap;">
        <ElChartGrow Title="移动平均（窗口 3）" Width="420" Height="280" Cls="demo-chart-ma">
            <ElChartSeries Items="MockData.SalesPoints" CategoryField="Category" ValueField="Value" Title="销量"
                           ChartType="ElChartType.Line" TrendLine="ElTrendLineType.MovingAverage" TrendLinePeriod="3" />
        </ElChartGrow>

        <ElChartGrow Title="二次拟合 + 参考带" Width="420" Height="280" Cls="demo-chart-poly"
                     ReferenceBands="@chartBands">
            <ElChartSeries Items="MockData.SalesPoints" CategoryField="Category" ValueField="Value" Title="销量"
                           ChartType="ElChartType.Area" TrendLine="ElTrendLineType.Polynomial" />
        </ElChartGrow>
    </div>
    }
</div>

<div class="demo-section">
    <h3>ElBarcodeGrow / ElQRCodeGrow 条码与二维码</h3>
    @if (builtSections > 5)
    {
    <div class="demo-row" style="align-items:flex-start;">
        <ElBarcodeGrow Value="ELEMENT-2026" Type="ElBarcodeGrowType.Code128" Height="80px" />
        <ElQRCodeGrow Value="https://element-plus.org" Size="160px" />
    </div>
    }
</div>

<div class="demo-section">
    <h3>ElMarkdownEditor Markdown 编辑器（Element.Markdown 可选包）</h3>
    @if (builtSections > 6)
    {
    <p class="demo-page-sub">
        左侧写字右侧即出的双栏编辑器：左侧是 CodeMirror（Markdown 语法高亮 + 行号 + 折叠 + 连续列表），
        右侧用 Markdig 实时渲染。编辑器本身在<b>可选包</b> <code>Element.Markdown</code> 里，
        需要 <code>builder.Services.AddMarkdown()</code> 注册工具栏各个按钮的处理程序。
        本演示只挑了纯文本相关的 12 个按钮——<code>File</code> / <code>Image</code> 需要配 <code>UploadUrl</code> 才会真正上传。
    </p>
    <div class="demo-row" style="margin-bottom:12px;">
        <ElButton OnClick="@LoadCaseRecord">加载病历模板</ElButton>
        <ElButton OnClick="@ClearMarkdown">清空</ElButton>
        <ElButton OnClick="@AppendFollowUp">追加随访表</ElButton>
        <span class="demo-note">字数：@((markdownText ?? string.Empty).Length)　（在左侧打字时这里会实时累加）</span>
    </div>
    <div style="max-width:980px;">
        <ElMarkdownEditor @bind-Value="markdownText"
                          Height="420"
                          EnableSyncScroll="true"
                          Icons="@markdownIcons" />
    </div>
    }
</div>

<div class="demo-section">
    <h3>ElMarkdownGrow Markdown 渲染</h3>
    @if (builtSections > 7)
    {
    <ElMarkdownGrow Text="@markdownText" />
    }
</div>

<div class="demo-section">
    <h3>ElHtmlEditorGrow 富文本编辑器</h3>
    @if (builtSections > 8)
    {
    <p class="demo-page-sub">
        工具栏 45 项（设计 / 源码双视图、表格命令、颜色面板、粘贴净化）全部内置，
        底层只用浏览器内建的 Selection / Range / execCommand，不依赖任何第三方编辑器。
        把 <code>Mode</code> 切到 <code>Source</code>（源码视图）后工具栏**依旧完整渲染**——图标不丢、布局不跳动，
        只是设计类命令一律置灰，仅「源码 / 设计视图」这一项可点。要让某几项彻底不出现，用 <code>HiddenTools</code>。
    </p>
    <div class="demo-row">
        <ElButton Type="@(editorMode == ElHtmlEditorGrowMode.Design ? ButtonType.Primary : ButtonType.Default)"
                  OnClick="@(() => editorMode = ElHtmlEditorGrowMode.Design)">设计视图</ElButton>
        <ElButton Type="@(editorMode == ElHtmlEditorGrowMode.Source ? ButtonType.Primary : ButtonType.Default)"
                  OnClick="@(() => editorMode = ElHtmlEditorGrowMode.Source)">源码视图</ElButton>
        <ElButton OnClick="@ResetEditor">重置内容</ElButton>
        <ElButton OnClick="@(() => editorReadOnly = !editorReadOnly)">
            @(editorReadOnly ? "解除只读" : "切换只读")
        </ElButton>
    </div>
    <div style="margin-top:12px;max-width:880px;">
        <ElHtmlEditorGrow @bind-Value="editorHtml"
                          Mode="editorMode"
                          ReadOnly="editorReadOnly"
                          Height="260px"
                          Placeholder="请输入病历文本…"
                          Change="OnEditorChange" />
    </div>
    <p class="demo-note">@editorNote</p>
    }
</div>

<div class="demo-section">
    <h3>ElDropDownTableGrow 下拉表格选择器</h3>
    @if (builtSections > 9)
    {
    <p class="demo-page-sub">
        把「表格 + 搜索 + 分页」塞进下拉面板。与 ElSelect 不同，它的面板是**原地渲染**的
        （<code>.el-dropdown-table-grow__panel</code>），所以不依赖 <code>&lt;ElPopup /&gt;</code>；
        列定义直接复用 <code>ElTableColumn</code>。
    </p>
    <div class="demo-row" style="align-items:flex-start;">
        <ElDropDownTableGrow Items="MockData.Products"
                             ValueField="Name"
                             TextField="Name"
                             Placeholder="选择药品（单选）"
                             Width="360px"
                             Height="0"
                             PageSize="3"
                             Clearable="true"
                             Value="@dropSingle"
                             ValueChanged="@((object v) => dropSingle = v as string)">
            <ElTableColumn Property="Name" Text="名称" Width="140" />
            <ElTableColumn Property="Category" Text="类别" Width="90" />
            <ElTableColumn Property="Price" Text="单价" Width="80" />
        </ElDropDownTableGrow>

        <ElDropDownTableGrow Items="MockData.Products"
                             Multiple="true"
                             ValueField="Name"
                             TextField="Name"
                             Placeholder="选择药品（多选）"
                             Width="420px"
                             Height="0"
                             PageSize="3"
                             Clearable="true"
                             Values="@dropMulti"
                             ValuesChanged="@OnDropMultiChanged">
            <ElTableColumn Property="Name" Text="名称" Width="140" />
            <ElTableColumn Property="Category" Text="类别" Width="90" />
            <ElTableColumn Property="Stock" Text="库存" Width="80" />
        </ElDropDownTableGrow>
    </div>
    <p class="demo-note">
        单选：@(string.IsNullOrEmpty(dropSingle) ? "（未选择）" : dropSingle)
        　多选：@(dropMulti.Count == 0 ? "（未选择）" : string.Join("、", dropMulti))
    </p>

    <h4>按指定字段搜索（SearchProperties，可多个）</h4>
    <p class="demo-page-sub">
        默认检索行对象的<strong>所有</strong>公开属性；给了 <code>SearchProperties</code> 就只在这些字段里匹配，
        命中任一字段即算匹配。下面这个只搜「名称 + 类别」：输入 <code>西药</code> 能命中（类别字段），
        输入 <code>12.5</code> 则命中不了（那是单价字段，已被排除）。
    </p>
    <div class="demo-row" style="align-items:flex-start;">
        <ElDropDownTableGrow Items="MockData.Products"
                             ValueField="Name"
                             TextField="Name"
                             Placeholder="选择药品（单选）"
