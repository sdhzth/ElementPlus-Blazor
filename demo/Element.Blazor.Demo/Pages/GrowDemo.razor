@code {

    // ---------------- 章节分批建（首屏先建前 2 节，其余每批 5 节补齐） ----------------
    // 为什么：本页一次性建完 20 节（4243 节点 / 34 个图表 / 228 个 svg）会把主线程连续死住约 1 秒，
    // 期间点击、滚动、切页签全无反应 —— 这是「操作不流畅」里唯一能稳定复现的秒级阻塞。
    //
    // 同窗口三臂实测（2026-10-10 19:12~19:21，同机、整机负载 26~51%、Debug、每臂 4 轮、
    // rAF 中位帧均 8ms、每轮均判定「计时可信」；日志 Temp/grow-baseline-runB.log、
    // Temp/grow-after-k5-runB.log、Temp/grow-after-k1-runC.log）：
    //   最长一次冻结   一次性建完 958/1033/967/1008ms
    //                 → 一批 5 节 459/408/442/475ms   （4 轮全赢，两组不重叠，降 2.1~2.4 倍）
    //                 → 一节一帧 483/358/358/367ms   （与一批 5 节区间重叠，分不出高下）
    //   长任务合计     一次性建完 2595/2386/2474/2390ms
    //                 → 一批 5 节 2699/2580/2805/2664ms（+8%，区间重叠＝基本持平）
    //                 → 一节一帧 4525~4902ms          （+70~90%，明显更差）
    //   落定用时       一次性建完 5.6~5.9s → 一批 5 节 5.6~6.2s → 一节一帧 8.4~9.2s
    //   落定 DOM       三臂完全一致：8553 / 本子树 4243 / svg 228 / 章节 20 / 图表 34，JS 异常 0
    // 所以取「一批 5 节」：冻结砍掉一半以上，总开销与落定时间跟改前持平。
    // 一节一帧为什么反而更差：每多渲染一次就要整页重跑一次 Blazor 差分（代价随已建节点数增长），
    // 18 次差分的额外开销超过了它省下的单次冻结。这条是量出来的，不是推的 —— 一节一帧臂在
    // 三臂序列的头（runB）和尾（runC）各测一次，总数都是 4.1~4.9s，排除了「先跑的吃亏」这种位置漂移。
    // 章节标题（h3）不参与闸门，所以页面骨架、锚点与滚动目标一进来就在。
    private const int GrowSectionCount = 20;

    /// <summary>已建到第几节（&gt;= 该序号的章节正文才渲染）。首屏先建前 <see cref="GrowEagerSections"/> 节。</summary>
    private const int GrowEagerSections = 2;

    /// <summary>每批补建几节。取 5 是实测最优点：再小（1 节/批）整页差分次数暴涨、总阻塞 +70~90%。</summary>
    private const int GrowSectionChunk = 5;

    private int builtSections = GrowEagerSections;

    /// <summary>分批建的独立取消源：页签被关掉/被淘汰时停住，不再往已卸载的渲染器上排队。</summary>
    private CancellationTokenSource? sectionPumpCts;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || sectionPumpCts != null || builtSections >= GrowSectionCount)
        {
            return;
        }

        sectionPumpCts = new CancellationTokenSource();
        var token = sectionPumpCts.Token;
        while (builtSections < GrowSectionCount)
        {
            try
            {
                await Task.Delay(60, token);
            }
            catch (OperationCanceledException)
            {
                return;
            }

            builtSections += GrowSectionChunk;
            if (builtSections > GrowSectionCount)
            {
                builtSections = GrowSectionCount;
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    void IDisposable.Dispose() => sectionPumpCts?.Cancel();
    // ---------------- ElIpAddressGrow 演示状态 ----------------
    private string ipValue = "192.168.1.10";
    private string ipSize = "normal";
    private bool ipDisabled;
    private bool ipReadonly;
    private bool ipDialogVisible;
    private string ipDialogValue;
    private string ipPreset = "10.0.0.255";

    private InputSize ipSizeValue => ipSize switch
    {
        "large" => InputSize.Large,
        "small" => InputSize.Small,
        _ => InputSize.Normal
    };

    /// <summary>把「套用到输入框」的文本交给组件：四段拆分/截断/钳位是组件自己的契约，这里只转交。</summary>
    private void ApplyIpPreset() => ipValue = ipPreset;

    /// <summary>对话框里的四段拆解展示（拿组件回传的 Value 现拆，不重复实现组件的规范化规则）。</summary>
    private string IpDialogSegments
    {
        get
        {
            var parts = (ipDialogValue ?? string.Empty).Split('.');
            return parts.Length == 4 ? string.Join(" · ", parts) : "（不是四段）";
        }
    }

    /// <summary>弹出对话框回显当前值（快照，不随后续输入变）。</summary>
    private void OpenIpDialog()
    {
        ipDialogValue = ipValue;
        ipDialogVisible = true;
    }

    // ---------------- ElMarqueeGrow 演示状态 ----------------
    private string marqueeDirection = "rtl";
    private string marqueeRound = "small";
    private int marqueeRadius = 10;
    private int marqueeDuration = 14;
