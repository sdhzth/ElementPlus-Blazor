    // ---------------- ElWaitingPopupGrow ----------------
    private ElWaitingPopupGrow waitingRef;
    private bool waitingVisible;
    private bool waitingMaskClosable;
    private bool waitingShowCancel = true;
    private bool waitingRound = true;
    private int waitingRadius;
    private string waitingBg = "#ffffff";
    private string waitingTitleColor = "#303133";
    private string waitingMessageColor = "#606266";
    private string waitingSpinnerColor = "#409eff";
    private string waitingStatus = "—";

    // 取消按钮（就是一个 ElButton）——文字 / 类型 / 尺寸 / 位置 / 朴素 / 圆角 / 自定义色 / 实心
    private string waitingCancelText = "取消";
    private string waitingBtnType = "Default";
    private string waitingBtnSize = "Default";
    private string waitingBtnPosition = "Center";
    private bool waitingBtnPlain;
    private bool waitingBtnRound;
    private bool waitingBtnUseColor;
    private string waitingBtnColor = "#f56c6c";
    private bool waitingBtnDark;

    private ButtonType waitingBtnTypeValue => waitingBtnType switch
    {
        "Primary" => ButtonType.Primary,
        "Success" => ButtonType.Success,
        "Warning" => ButtonType.Warning,
        "Danger" => ButtonType.Danger,
        "Info" => ButtonType.Info,
        _ => ButtonType.Default
    };

    private ButtonSize waitingBtnSizeValue => waitingBtnSize switch
    {
        "Large" => ButtonSize.Large,
        "Small" => ButtonSize.Small,
        _ => ButtonSize.Default
    };

    private ElWaitingPopupGrowActionAlign waitingBtnPositionValue => waitingBtnPosition switch
    {
        "Left" => ElWaitingPopupGrowActionAlign.Left,
        "Right" => ElWaitingPopupGrowActionAlign.Right,
        _ => ElWaitingPopupGrowActionAlign.Center
    };

    /// <summary>命令式：@ref 拿实例后 Show()，模拟一段后台工作，3 秒后自动 Hide()。</summary>
    private async Task OpenWaitingImperative()
    {
        waitingStatus = "打开（命令式）";
        await waitingRef.Show();
        await Task.Delay(3000);
        await waitingRef.Hide();
        waitingStatus = "已自动关闭";
    }

    /// <summary>声明式：直接翻转绑定的 waitingVisible。</summary>
    private void OpenWaitingBind()
    {
        waitingVisible = true;
        waitingStatus = "打开（bind）";
    }

    private void CloseWaitingBind()
    {
        waitingVisible = false;
        waitingStatus = "已关闭（bind）";
    }

    /// <summary>取消回调：命令式与声明式两个浮层共用；这里只把声明式那一个关掉并给出状态。</summary>
    private void OnWaitingCancel()
    {
        waitingVisible = false;
        waitingStatus = "已取消";
    }
