@page "/border"
@using ElementPlus

<h1 class="demo-page-title">边框 / Border 工具类（CSS 变量）</h1>
<p class="demo-page-sub">对齐官方 Border 文档：Element Plus 通过一组 CSS 变量统一规范边框、圆角与阴影，可用于按钮、卡片、弹窗等。下面用这些变量做可视化参考。</p>

<div class="demo-section">
    <h3>边框样式（border-style）</h3>
    <div class="demo-row demo-row-wrap">
        <div style="width:160px;height:44px;border-top:1px solid var(--el-border-color);display:flex;align-items:center;padding:0 10px;">Solid 1px</div>
        <div style="width:160px;height:44px;border-top:2px dashed var(--el-border-color);display:flex;align-items:center;padding:0 10px;">Dashed 2px</div>
    </div>
</div>

<div class="demo-section">
    <h3>边框颜色（语义色）</h3>
    <div class="demo-row demo-row-wrap">
        <div style="width:120px;height:44px;border:1px solid var(--el-color-primary);color:var(--el-color-primary);display:flex;align-items:center;justify-content:center;">Primary</div>
        <div style="width:120px;height:44px;border:1px solid var(--el-color-success);color:var(--el-color-success);display:flex;align-items:center;justify-content:center;">Success</div>
        <div style="width:120px;height:44px;border:1px solid var(--el-color-warning);color:var(--el-color-warning);display:flex;align-items:center;justify-content:center;">Warning</div>
        <div style="width:120px;height:44px;border:1px solid var(--el-color-danger);color:var(--el-color-danger);display:flex;align-items:center;justify-content:center;">Danger</div>
        <div style="width:120px;height:44px;border:1px solid var(--el-color-info);color:var(--el-color-info);display:flex;align-items:center;justify-content:center;">Info</div>
    </div>
</div>

<div class="demo-section">
    <h3>边框颜色（深浅梯度）</h3>
    <div class="demo-row demo-row-wrap">
        <div style="width:110px;height:44px;border:1px solid var(--el-border-color);display:flex;align-items:center;justify-content:center;">default</div>
        <div style="width:110px;height:44px;border:1px solid var(--el-border-color-light);display:flex;align-items:center;justify-content:center;">light</div>
        <div style="width:110px;height:44px;border:1px solid var(--el-border-color-lighter);display:flex;align-items:center;justify-content:center;">lighter</div>
        <div style="width:110px;height:44px;border:1px solid var(--el-border-color-extra-light);display:flex;align-items:center;justify-content:center;">extra-light</div>
        <div style="width:110px;height:44px;border:1px solid var(--el-border-color-dark);display:flex;align-items:center;justify-content:center;">dark</div>
        <div style="width:110px;height:44px;border:1px solid var(--el-border-color-darker);display:flex;align-items:center;justify-content:center;">darker</div>
    </div>
</div>

<div class="demo-section">
    <h3>圆角（border-radius）</h3>
    <div class="demo-row demo-row-wrap">
        <div style="width:80px;height:80px;border:1px solid var(--el-border-color);border-radius:0;display:flex;align-items:center;justify-content:center;">None 0</div>
        <div style="width:80px;height:80px;border:1px solid var(--el-border-color);border-radius:var(--el-border-radius-small);display:flex;align-items:center;justify-content:center;">Small 2px</div>
        <div style="width:80px;height:80px;border:1px solid var(--el-border-color);border-radius:var(--el-border-radius-base);display:flex;align-items:center;justify-content:center;">Base 4px</div>
        <div style="width:80px;height:80px;border:1px solid var(--el-border-color);border-radius:var(--el-border-radius-round);display:flex;align-items:center;justify-content:center;">Round 20px</div>
        <div style="width:80px;height:80px;border:1px solid var(--el-border-color);border-radius:var(--el-border-radius-circle);display:flex;align-items:center;justify-content:center;">Circle</div>
    </div>
</div>

<div class="demo-section">
    <h3>阴影（box-shadow）</h3>
    <div class="demo-row demo-row-wrap">
        <div style="width:120px;height:80px;box-shadow:var(--el-box-shadow);display:flex;align-items:center;justify-content:center;">Basic</div>
        <div style="width:120px;height:80px;box-shadow:var(--el-box-shadow-light);display:flex;align-items:center;justify-content:center;">Light</div>
        <div style="width:120px;height:80px;box-shadow:var(--el-box-shadow-lighter);display:flex;align-items:center;justify-content:center;">Lighter</div>
        <div style="width:120px;height:80px;box-shadow:var(--el-box-shadow-dark);display:flex;align-items:center;justify-content:center;">Dark</div>
    </div>
</div>

<p class="demo-note">这些变量定义在 <code>index.css</code> 的 :root 中（如 <code>--el-border</code>、<code>--el-border-radius-base</code>、<code>--el-box-shadow</code>），直接用于行内样式或自定义类中即可。</p>
