@page "/popconfirm"
@using ElementPlus

<h1 class="demo-page-title">ElPopconfirm 气泡确认框（对齐 Element Plus Popconfirm）</h1>
<p class="demo-page-sub">
    点击元素时弹出的二次确认气泡。支持标题/正文、确认/取消按钮文案与类型、图标类型、自定义操作区插槽与 confirm/cancel 事件。
</p>

<div class="demo-section">
    <h3>基础用法</h3>
    <div class="demo-row demo-row-wrap">
        <ElPopconfirm Title="确定删除该条记录吗？" OnConfirm="OnConfirm" OnCancel="OnCancel">
            <Reference><ElButton Type="ButtonType.Danger">删除</ElButton></Reference>
        </ElPopconfirm>
    </div>
    <p class="demo-note">最近一次操作：@lastAction</p>
</div>

<div class="demo-section">
    <h3>自定义按钮文案 / 图标类型</h3>
    <div class="demo-row demo-row-wrap">
        <ElPopconfirm Title="是否提交审批？" ConfirmButtonText="提交" CancelButtonText="再想想"
                      ConfirmButtonType="ButtonType.Success" Type="PopconfirmType.Success">
            <Reference><ElButton>提交审批</ElButton></Reference>
        </ElPopconfirm>
        <ElPopconfirm Title="操作不可恢复" Type="PopconfirmType.Error" IconColor="#f56c6c">
            <Reference><ElButton Type="ButtonType.Warning">危险操作</ElButton></Reference>
        </ElPopconfirm>
    </div>
</div>

<div class="demo-section">
    <h3>自定义操作区插槽（actions）</h3>
    <ElPopconfirm Title="选择处理方式">
        <ActionsContent>
            <div class="demo-row">
                <ElButton Size="ButtonSize.Small" Type="ButtonType.Primary" OnClick="OnConfirm">归档</ElButton>
                <ElButton Size="ButtonSize.Small" Type="ButtonType.Info" OnClick="OnCancel">转交</ElButton>
            </div>
        </ActionsContent>
        <Reference><ElButton>更多操作</ElButton></Reference>
    </ElPopconfirm>
</div>

<div class="demo-section" id="sec-popconfirm-fixed">
    <h3>表格操作列里使用（FixedPopper 钉视口，不再被裁剪/挤压）</h3>
    <p class="demo-page-sub">
        气泡是触发按钮的子孙元素，默认 absolute 会被表格的 overflow 链（<code>.cell</code> hidden →
        <code>.el-table__body-wrapper</code> auto → <code>.el-table</code> hidden）裁掉——表现为只露一条黑边，
        或者整条气泡跟按钮挤成一行。本库默认 <code>FixedPopper="true"</code>：弹出瞬间实测触发按钮的视口矩形，
        把气泡钉成 <code>position:fixed</code>，在哪个容器里都能浮在最顶层；上方放不下自动翻到下方（箭头跟着翻）。
        本表列总宽超出容器，可横向滚动后点「删除」验证。
    </p>

    <div style="width:560px;max-width:100%;">
        <ElTable DataSource="opRows" AutoGenerateColumns="false" HasSelectionColumn="false" Border="true">
            <ElTableColumn Property="Id" Text="ID" Width="80" />
            <ElTableColumn Property="Name" Text="名称" Width="220" />
            <ElTableColumn Property="Category" Text="类别" Width="220" />
            <ElTableColumn Property="Supplier" Text="供应商" Width="220" />
            <ElTableColumn Property="Price" Text="单价" Width="140" Align="right" />
            <ElTableTemplateColumn Text="操作" Width="140" Fixed="TableColumnFixed.Right">
                <ElPopconfirm Title="确定要删除该条记录吗？" OnConfirm="OnConfirm" OnCancel="OnCancel">
                    <Reference>
                        <ElButton Size="ButtonSize.Small" Type="ButtonType.Danger">删除</ElButton>
                    </Reference>
                </ElPopconfirm>
            </ElTableTemplateColumn>
        </ElTable>
    </div>
    <p class="demo-note">最近一次操作：@lastAction</p>
</div>

@code {
    private string lastAction = "无";
    private List<Product> opRows = MockData.Products.Take(4).ToList();

    private void OnConfirm() => lastAction = "已确认";

    private void OnCancel() => lastAction = "已取消";
}
