@page "/login"
@layout LoginLayout
@inject NavigationManager Nav

<div class="el-login-wrapper">
    <div class="el-login-left">
        <div class="el-login-brand">
            <div class="el-login-logo">E</div>
            <div class="el-login-title">Element-Plus Blazor</div>
            <div class="el-login-sub">标准组件 · 开箱即用 · 零第三方 JS 依赖</div>
        </div>
        <div class="el-login-footer">© 2026 Element-Plus Blazor Demo</div>
    </div>

    <div class="el-login-right">
        <div class="el-login-form-wrap">
            <h2 class="el-login-heading">欢迎登录</h2>
            <p class="el-login-desc">请使用演示账号进入组件中心</p>

            <ElForm Model="@model" OnValidSubmit="@OnLogin">
                <ElFormItem TValue="string" Name="UserName" Label="账号" Required="true">
                    <ElInput TValue="string" @bind-Value="@model.UserName"
                        Placeholder="请输入账号（admin）" EnableClearButton="true">
                        <template #Prefix>
                            <ElIcon Name="el-icon-user" />
                        </template>
                    </ElInput>
                </ElFormItem>

                <ElFormItem TValue="string" Name="Password" Label="密码" Required="true">
                    <ElInput TValue="string" @bind-Value="@model.Password"
                        Placeholder="请输入密码（123456）"
                        Type="InputType.Password" ShowPassword="true">
                        <template #Prefix>
                            <ElIcon Name="el-icon-lock" />
                        </template>
                    </ElInput>
                </ElFormItem>

                <ElFormItem TValue="string" Name="Remember">
                    <div class="el-login-row">
                        <ElCheckbox TValue="bool" @bind-Value="@model.Remember">记住我</ElCheckbox>
                        <a class="el-login-link" href="javascript:;">忘记密码？</a>
                    </div>
                </ElFormItem>

                <ElButton Type="ButtonType.Primary" Size="ButtonSize.Large"
                    Style="width:100%" OnClick="@OnLogin" Loading="@loading">
                    <text>登 录</text>
                </ElButton>
            </ElForm>

            <div class="el-login-footer-right">
                <span>还没有账号？</span>
                <a class="el-login-link" href="javascript:;">立即注册</a>
            </div>

            <div class="el-login-divider"><span>其他方式登录</span></div>

            <div class="el-login-social">
                <ElButton Circle="true" Size="ButtonSize.Large">
                    <ElIcon Name="el-icon-chat-dot-round" />
                </ElButton>
                <ElButton Circle="true" Size="ButtonSize.Large" Type="ButtonType.Success">
                    <ElIcon Name="el-icon-mobile-phone" />
                </ElButton>
                <ElButton Circle="true" Size="ButtonSize.Large" Type="ButtonType.Warning">
                    <ElIcon Name="el-icon-key" />
                </ElButton>
            </div>

            @if (!string.IsNullOrEmpty(msg))
            {
                <ElAlert Type="ElementPlus.MessageType.Error" Title="@msg" ShowClose="false" />
            }
        </div>
    </div>
</div>

@code {
    private LoginModel model = new();
    private bool loading;
    private string msg = string.Empty;

    private async Task OnLogin()
    {
        msg = string.Empty;
        if (string.IsNullOrWhiteSpace(model.UserName) || string.IsNullOrWhiteSpace(model.Password))
        {
            msg = "账号或密码不能为空";
            return;
        }
        loading = true;
        await Task.Delay(600);
        loading = false;

        if (model.UserName == "admin" && model.Password == "123456")
        {
            Nav.NavigateTo("");
        }
        else
        {
            msg = "账号或密码错误，请使用 admin / 123456";
        }
    }

    class LoginModel
    {
        public string UserName { get; set; } = "";
        public string Password { get; set; } = "";
        public bool Remember { get; set; } = true;
    }
}